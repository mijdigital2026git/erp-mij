---
import Layout from '../layouts/Layout.astro';
import { KeyRound, ArrowRight, Loader2, Info, Eye, EyeOff } from '@lucide/astro';

// SEO details
const pageTitle = "Login - MIJ ERP Cloud";
const metaDescription = "Access the next-generation MIJ ERP dashboard using your unique login code.";
---

<Layout title={pageTitle}>
  <div class="login-container">
    <div class="login-card">
      <div class="logo-area">
        <img src="/logo.webp" alt="MIJ Logo" class="logo-image" />
        <h2>MIJ<span>ERP</span></h2>
      </div>
      
      <div class="header-text">
        <h1>Enterprise Portal</h1>
        <p>Enter your authorization code to access the dashboard</p>
      </div>

      <form id="login-form" class="login-form">
        <div class="form-group">
          <label for="login-code">Access Code</label>
          <div class="input-wrapper">
            <KeyRound size={18} class="input-icon" />
            <input 
              type="password" 
              id="login-code" 
              placeholder="••••••••••••" 
              class="form-control" 
              required 
            />
            <button type="button" id="toggle-password-btn" class="toggle-password-btn" aria-label="Toggle Password Visibility">
              <Eye size={18} id="eye-icon" />
              <EyeOff size={18} id="eye-off-icon" class="hidden" />
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-full justify-center" id="login-btn">
          <Loader2 size={18} class="animate-spin mr-2 hidden" id="login-loader" />
          <span id="btn-text">Authenticate</span>
          <ArrowRight size={16} id="btn-arrow" />
        </button>
      </form>

      <div id="login-error" class="error-banner hidden">
        <span id="error-message">Invalid credentials.</span>
      </div>
    </div>
  </div>

  <!-- Auto Login Confirmation Modal -->
  <div id="auto-login-modal" class="modal-overlay hidden">
    <div class="modal-container">
      <div class="modal-header">
        <h2>Instant Access</h2>
      </div>
      <div class="modal-body">
        <p style="text-align: left; line-height: 1.5; color: var(--text-primary);">Do you want to log in using the detected access code <strong id="detected-code-span" style="font-family: monospace; color: var(--primary);">CLIENT123</strong>?</p>
        <div class="modal-footer" style="margin-top: 20px;">
          <button type="button" id="cancel-auto-login-btn" class="btn btn-secondary">No, Enter Manually</button>
          <button type="button" id="confirm-auto-login-btn" class="btn btn-primary">Yes, Log In Now</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  :root {
    --bg-light: #f8fafc;
    --bg-card: #ffffff;
    --border-color: #cbd5e1;
    --text-primary: #0f172a;
    --text-secondary: #475569;
    --primary: #2563eb;
    --primary-hover: #1d4ed8;
    --danger: #dc2626;
    --danger-bg: #fee2e2;
    
    --font-heading: system-ui, -apple-system, sans-serif;
    --font-body: system-ui, -apple-system, sans-serif;
  }

  body {
    background-color: var(--bg-light);
    color: var(--text-primary);
    font-family: var(--font-body);
    margin: 0;
  }

  .login-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    width: 100vw;
    background-image: url('/elegant-luxury-background.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Login Card */
  .login-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 32px;
    width: 100%;
    max-width: 400px;
    box-sizing: border-box;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
  }

  .logo-area {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .logo-image {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    object-fit: cover;
  }

  .logo-area h2 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    margin: 0;
    color: var(--text-primary);
  }

  .logo-area h2 span {
    color: var(--primary);
  }

  .header-text {
    text-align: center;
    margin-bottom: 24px;
  }

  .header-text h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px;
    margin: 0 0 6px 0;
    color: var(--text-primary);
  }

  .header-text p {
    color: var(--text-secondary);
    margin: 0;
    font-size: 13.5px;
    line-height: 1.4;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 12px;
    color: var(--text-secondary);
  }

  .form-control {
    width: 100%;
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    padding: 10px 38px 10px 38px;
    border-radius: 6px;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 14px;
    box-sizing: border-box;
    transition: border-color 0.15s ease;
  }

  .form-control:focus {
    border-color: var(--primary);
    outline: none;
  }

  /* Toggle Password Button */
  .toggle-password-btn {
    position: absolute;
    right: 12px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: color 0.15s ease;
  }

  .toggle-password-btn:hover {
    color: var(--text-primary);
  }

  /* Buttons */
  .btn {
    border: 1px solid transparent;
    outline: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    padding: 10px 16px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: background-color 0.15s ease;
  }

  .btn-primary {
    background-color: var(--primary);
    color: white;
  }

  .btn-primary:hover {
    background-color: var(--primary-hover);
  }

  .w-full {
    width: 100%;
  }

  .justify-center {
    justify-content: center;
  }

  .error-banner {
    background-color: var(--danger-bg);
    border: 1px solid rgba(239, 68, 68, 0.2);
    padding: 10px;
    border-radius: 6px;
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--danger);
    text-align: center;
    font-weight: 500;
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }

  .mr-2 {
    margin-right: 6px;
  }

  .hidden {
    display: none !important;
  }

  /* Modal overlay and form styles */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(15, 23, 42, 0.3);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 16px;
    box-sizing: border-box;
  }

  .modal-container {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    width: 100%;
    max-width: 400px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .modal-header {
    padding: 16px 20px;
    border-bottom: 1px solid #cbd5e1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #f8fafc;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
  }

  .modal-body {
    padding: 20px;
    box-sizing: border-box;
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

<script>
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const loginBtn = document.getElementById('login-btn') as HTMLButtonElement;
  const loginLoader = document.getElementById('login-loader');
  const btnArrow = document.getElementById('btn-arrow');
  const btnText = document.getElementById('btn-text');
  const errorBanner = document.getElementById('login-error');
  const errorMessage = document.getElementById('error-message');

  // Toggle Password Visibility
  const togglePasswordBtn = document.getElementById('toggle-password-btn');
  const passwordInput = document.getElementById('login-code') as HTMLInputElement;
  const eyeIcon = document.getElementById('eye-icon');
  const eyeOffIcon = document.getElementById('eye-off-icon');

  if (togglePasswordBtn && passwordInput && eyeIcon && eyeOffIcon) {
    togglePasswordBtn.addEventListener('click', () => {
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.classList.add('hidden');
        eyeOffIcon.classList.remove('hidden');
      } else {
        passwordInput.type = 'password';
        eyeIcon.classList.remove('hidden');
        eyeOffIcon.classList.add('hidden');
      }
    });
  }

  if (loginForm && loginBtn && btnText) {
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Reset state
      if (errorBanner) errorBanner.classList.add('hidden');
      loginBtn.disabled = true;
      if (loginLoader) loginLoader.classList.remove('hidden');
      if (btnArrow) btnArrow.classList.add('hidden');
      btnText.textContent = "Authenticating...";

      const codeInput = document.getElementById('login-code') as HTMLInputElement;
      const code = codeInput ? codeInput.value.trim() : '';

      try {
        const response = await fetch('/api/auth', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ code })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          // Success: redirect to dashboard based on role
          window.location.href = `/${data.role}`;
        } else {
          // Show error
          if (errorMessage) errorMessage.textContent = data.error || 'Authentication failed.';
          if (errorBanner) errorBanner.classList.remove('hidden');
          
          // Reset button
          loginBtn.disabled = false;
          if (loginLoader) loginLoader.classList.add('hidden');
          if (btnArrow) btnArrow.classList.remove('hidden');
          btnText.textContent = "Authenticate";
        }
      } catch (err: any) {
        if (errorMessage) errorMessage.textContent = 'Network error. Please try again.';
        if (errorBanner) errorBanner.classList.remove('hidden');
        
        loginBtn.disabled = false;
        if (loginLoader) loginLoader.classList.add('hidden');
        if (btnArrow) btnArrow.classList.remove('hidden');
        btnText.textContent = "Authenticate";
      }
    });
  }

  // Auto-login from query parameter '?code=...'
  const urlParams = new URLSearchParams(window.location.search);
  const codeParam = urlParams.get('code');
  
  const autoLoginModal = document.getElementById('auto-login-modal');
  const detectedCodeSpan = document.getElementById('detected-code-span');
  const confirmAutoLoginBtn = document.getElementById('confirm-auto-login-btn');
  const cancelAutoLoginBtn = document.getElementById('cancel-auto-login-btn');

  if (codeParam && passwordInput && autoLoginModal && detectedCodeSpan && confirmAutoLoginBtn && cancelAutoLoginBtn && loginForm) {
    // Fill the input field
    passwordInput.value = codeParam;
    detectedCodeSpan.textContent = codeParam;
    
    // Show confirmation popup modal
    autoLoginModal.classList.remove('hidden');

    confirmAutoLoginBtn.addEventListener('click', () => {
      autoLoginModal.classList.add('hidden');
      loginForm.dispatchEvent(new Event('submit'));
    });

    cancelAutoLoginBtn.addEventListener('click', () => {
      autoLoginModal.classList.add('hidden');
      passwordInput.value = ''; // clear code
    });
  }
</script>
