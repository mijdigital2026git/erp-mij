---
import Layout from '../layouts/Layout.astro';
import { KeyRound, ArrowRight, Loader2, Info, Eye, EyeOff } from '@lucide/astro';

// SEO details
const pageTitle = "Login - MIJ ERP Cloud";
const metaDescription = "Access the next-generation MIJ ERP dashboard using your unique login code.";
---

<Layout>
  <head>
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <div class="login-container">
    <div class="login-card">
      <div class="logo-area">
        <div class="logo-icon">M</div>
        <h2>MIJ<span>ERP</span></h2>
      </div>
      
      <div class="header-text">
        <h1>Enterprise Portal</h1>
        <p>Enter your authorization code to access the dashboard</p>
      </div>

      <form id="login-form" class="login-form">
        <div class="form-group">
          <label for="login-code">Access Code</label>
          <div class="input-wrapper">
            <KeyRound size={18} class="input-icon" />
            <input 
              type="password" 
              id="login-code" 
              placeholder="••••••••••••" 
              class="form-control" 
              required 
            />
            <button type="button" id="toggle-password-btn" class="toggle-password-btn" aria-label="Toggle Password Visibility">
              <Eye size={18} id="eye-icon" />
              <EyeOff size={18} id="eye-off-icon" class="hidden" />
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-full justify-center" id="login-btn">
          <Loader2 size={18} class="animate-spin mr-2 hidden" id="login-loader" />
          <span id="btn-text">Authenticate</span>
          <ArrowRight size={16} id="btn-arrow" />
        </button>
      </form>

      <div id="login-error" class="error-banner hidden">
        <span id="error-message">Invalid credentials.</span>
      </div>
    </div>
  </div>
</Layout>

<style>
  :root {
    --bg-dark: #09090b;
    --bg-card: #18181b;
    --border-color: #27272a;
    --text-primary: #f4f4f5;
    --text-secondary: #a1a1aa;
    --primary: #2563eb;
    --primary-hover: #1d4ed8;
    --danger: #ef4444;
    --danger-bg: rgba(239, 68, 68, 0.1);
    
    --font-heading: system-ui, -apple-system, sans-serif;
    --font-body: system-ui, -apple-system, sans-serif;
  }

  body {
    background-color: var(--bg-dark);
    color: var(--text-primary);
    font-family: var(--font-body);
    margin: 0;
  }

  .login-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    width: 100vw;
    background-color: var(--bg-dark);
  }

  /* Login Card */
  .login-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 32px;
    width: 100%;
    max-width: 400px;
    box-sizing: border-box;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
  }

  .logo-area {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .logo-icon {
    background: var(--primary);
    width: 32px;
    height: 32px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    color: white;
  }

  .logo-area h2 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    margin: 0;
    color: var(--text-primary);
  }

  .logo-area h2 span {
    color: #38bdf8;
  }

  .header-text {
    text-align: center;
    margin-bottom: 24px;
  }

  .header-text h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px;
    margin: 0 0 6px 0;
    color: var(--text-primary);
  }

  .header-text p {
    color: var(--text-secondary);
    margin: 0;
    font-size: 13.5px;
    line-height: 1.4;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 12px;
    color: var(--text-secondary);
  }

  .form-control {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--border-color);
    padding: 10px 38px 10px 38px;
    border-radius: 6px;
    color: white;
    font-family: var(--font-body);
    font-size: 14px;
    box-sizing: border-box;
    transition: border-color 0.15s ease;
  }

  .form-control:focus {
    border-color: var(--primary);
    outline: none;
  }

  /* Toggle Password Button */
  .toggle-password-btn {
    position: absolute;
    right: 12px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: color 0.15s ease;
  }

  .toggle-password-btn:hover {
    color: var(--text-primary);
  }

  /* Buttons */
  .btn {
    border: 1px solid transparent;
    outline: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    padding: 10px 16px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: background-color 0.15s ease;
  }

  .btn-primary {
    background-color: var(--primary);
    color: white;
  }

  .btn-primary:hover {
    background-color: var(--primary-hover);
  }

  .w-full {
    width: 100%;
  }

  .justify-center {
    justify-content: center;
  }

  .error-banner {
    background-color: var(--danger-bg);
    border: 1px solid rgba(239, 68, 68, 0.2);
    padding: 10px;
    border-radius: 6px;
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--danger);
    text-align: center;
    font-weight: 500;
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }

  .mr-2 {
    margin-right: 6px;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

<script>
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const loginBtn = document.getElementById('login-btn') as HTMLButtonElement;
  const loginLoader = document.getElementById('login-loader');
  const btnArrow = document.getElementById('btn-arrow');
  const btnText = document.getElementById('btn-text');
  const errorBanner = document.getElementById('login-error');
  const errorMessage = document.getElementById('error-message');

  // Toggle Password Visibility
  const togglePasswordBtn = document.getElementById('toggle-password-btn');
  const passwordInput = document.getElementById('login-code') as HTMLInputElement;
  const eyeIcon = document.getElementById('eye-icon');
  const eyeOffIcon = document.getElementById('eye-off-icon');

  if (togglePasswordBtn && passwordInput && eyeIcon && eyeOffIcon) {
    togglePasswordBtn.addEventListener('click', () => {
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.classList.add('hidden');
        eyeOffIcon.classList.remove('hidden');
      } else {
        passwordInput.type = 'password';
        eyeIcon.classList.remove('hidden');
        eyeOffIcon.classList.add('hidden');
      }
    });
  }

  if (loginForm && loginBtn && btnText) {
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Reset state
      if (errorBanner) errorBanner.classList.add('hidden');
      loginBtn.disabled = true;
      if (loginLoader) loginLoader.classList.remove('hidden');
      if (btnArrow) btnArrow.classList.add('hidden');
      btnText.textContent = "Authenticating...";

      const codeInput = document.getElementById('login-code') as HTMLInputElement;
      const code = codeInput ? codeInput.value.trim() : '';

      try {
        const response = await fetch('/api/auth', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ code })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          // Success: redirect to dashboard based on role
          window.location.href = `/${data.role}`;
        } else {
          // Show error
          if (errorMessage) errorMessage.textContent = data.error || 'Authentication failed.';
          if (errorBanner) errorBanner.classList.remove('hidden');
          
          // Reset button
          loginBtn.disabled = false;
          if (loginLoader) loginLoader.classList.add('hidden');
          if (btnArrow) btnArrow.classList.remove('hidden');
          btnText.textContent = "Authenticate";
        }
      } catch (err: any) {
        if (errorMessage) errorMessage.textContent = 'Network error. Please try again.';
        if (errorBanner) errorBanner.classList.remove('hidden');
        
        loginBtn.disabled = false;
        if (loginLoader) loginLoader.classList.add('hidden');
        if (btnArrow) btnArrow.classList.remove('hidden');
        btnText.textContent = "Authenticate";
      }
    });
  }
</script>
