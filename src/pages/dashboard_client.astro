---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import { 
  Plus, 
  Video, 
  CheckCircle, 
  Loader2, 
  FileVideo, 
  HelpCircle,
  FolderOpen
} from '@lucide/astro';

const user = (Astro.locals as any).user;
if (!user) {
  return Astro.redirect('/login');
}
---

<Layout>
  <head>
    <title>Client Portal - MIJ ERP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <Sidebar role="client" />

  <div class="app-container">
    <Header userName={user.name} userRole={user.role} title="Client Portal" />

    <!-- Main Content -->
    <main class="main-content">
      
      <!-- VIEW: Overview -->
      <div id="view-overview" class="client-view">
        <div class="workspace-header-bar">
          <div>
            <h2>My Task & Complaint List</h2>
            <p class="subtitle">Submit complaints and track resolution progress in real-time.</p>
          </div>
          
          <button class="btn btn-primary" id="open-modal-btn">
            <Plus size={18} />
            <span>Add Complaint / Change</span>
          </button>
        </div>

        <!-- Premium Statistics Cards Grid -->
        <div class="stats-overview-grid">
          <div class="stat-card">
            <div class="stat-title">Total Requests</div>
            <div class="stat-value" id="stat-total">0</div>
          </div>
          <div class="stat-card in-progress">
            <div class="stat-title">In Progress</div>
            <div class="stat-value" id="stat-progress">0</div>
          </div>
          <div class="stat-card review">
            <div class="stat-title">Under Review</div>
            <div class="stat-value" id="stat-review">0</div>
          </div>
          <div class="stat-card completed">
            <div class="stat-title">Completed</div>
            <div class="stat-value" id="stat-completed">0</div>
          </div>
        </div>

        <!-- Local Sub-Tabs for Overview -->
        <div class="local-tabs" style="display: flex; gap: 10px; border-bottom: 2px solid #cbd5e1; margin-bottom: 20px;">
          <button class="local-tab-btn active" id="local-tab-requests" style="background: none; border: none; padding: 8px 16px; font-family: inherit; font-size: 14.5px; font-weight: 700; color: var(--primary); border-bottom: 2px solid var(--primary); cursor: pointer; transition: none; outline: none; margin-bottom: -2px;">
            Request List
          </button>
          <button class="local-tab-btn" id="local-tab-info" style="background: none; border: none; padding: 8px 16px; font-family: inherit; font-size: 14.5px; font-weight: 600; color: var(--text-secondary); cursor: pointer; transition: none; outline: none; margin-bottom: -2px;">
            Project Info
          </button>
        </div>

        <!-- Local Tab content: Request List -->
        <div id="local-view-requests">
          <!-- Category & Status Filter Row -->
          <div style="display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 18px; align-items: center;">
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
              <span style="font-size: 11.5px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;">Category:</span>
              <div class="filter-tabs" id="filter-tabs" style="margin: 0; display: inline-flex; gap: 4px;">
                <button class="filter-btn active" data-category="all">All Categories</button>
                <button class="filter-btn" data-category="UI Bug">UI Bug</button>
                <button class="filter-btn" data-category="Feature Request">Feature Request</button>
                <button class="filter-btn" data-category="Design Change">Design Change</button>
              </div>
            </div>
            
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
              <span style="font-size: 11.5px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;">Status:</span>
              <div class="filter-tabs" id="filter-status-tabs" style="margin: 0; display: inline-flex; gap: 4px;">
                <button class="filter-btn active" data-status="all">All Status</button>
                <button class="filter-btn" data-status="review">Under Review</button>
                <button class="filter-btn" data-status="proses">In Progress</button>
                <button class="filter-btn" data-status="selesai">Completed</button>
              </div>
            </div>
          </div>

          <!-- Task/Complaint Spreadsheet Table -->
          <div class="excel-table-container">
            <table class="excel-table">
              <thead>
                <tr>
                  <th style="width: 50px;">No</th>
                  <th style="width: 180px;">Title / Category</th>
                  <th style="width: 30%;">Description</th>
                  <th>Video Link</th>
                  <th>Status</th>
                  <th style="width: 25%;">Admin Resolution</th>
                  <th>Verification Photo</th>
                  <th style="width: 150px;">Actions</th>
                </tr>
              </thead>
              <tbody id="client-tasks-body">
                <tr id="loading-row">
                  <td colspan="8" style="text-align: center; padding: 24px;">
                    <div style="display: flex; align-items: center; justify-content: center; gap: 8px; color: var(--text-secondary);">
                      <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line></svg>
                      <span>Loading complaints from database...</span>
                    </div>
                  </td>
                </tr>
                <tr id="empty-row" class="hidden">
                  <td colspan="8" style="text-align: center; padding: 24px; color: var(--text-secondary);">
                    No complaints found. Click "Add Complaint / Change" above to submit one.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Local Tab content: Project Info -->
        <div id="local-view-info" class="hidden" style="background-color: #ffffff; border: 1px solid #cbd5e1; border-radius: 12px; padding: 24px; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05); display: flex; flex-direction: column; gap: 20px;">
          <!-- Project Specs Table -->
          <div style="border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden;">
            <table class="excel-table" style="width: 100%; border-collapse: collapse; margin: 0; box-shadow: none; border: none;">
              <tbody>
                <tr>
                  <td style="width: 200px; font-weight: 600; background-color: #f8fafc; border-right: 1px solid #cbd5e1; border-bottom: 1px solid #cbd5e1; padding: 12px 16px;">Project Name</td>
                  <td id="client-info-project-name" style="font-weight: 600; border-bottom: 1px solid #cbd5e1; padding: 12px 16px; color: var(--text-primary);">-</td>
                </tr>
                <tr>
                  <td style="font-weight: 600; background-color: #f8fafc; border-right: 1px solid #cbd5e1; border-bottom: 1px solid #cbd5e1; padding: 12px 16px;">Project Deadline</td>
                  <td id="client-info-project-deadline" style="font-weight: 600; border-bottom: 1px solid #cbd5e1; padding: 12px 16px; color: var(--text-primary);">-</td>
                </tr>
                <tr>
                  <td style="font-weight: 600; background-color: #f8fafc; border-right: 1px solid #cbd5e1; padding: 12px 16px;">Contact Person</td>
                  <td id="client-info-contact" style="font-weight: 600; padding: 12px 16px; color: var(--text-primary);">-</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Announcement Text -->
          <div style="display: flex; flex-direction: column; gap: 8px; border-top: 1px solid #cbd5e1; padding-top: 16px;">
            <h3 style="margin: 0; font-size: 14px; font-weight: 700; color: var(--text-primary);">Project Updates & Announcements</h3>
            <div id="client-info-announcement" style="background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 16px; font-size: 13.5px; line-height: 1.6; color: var(--text-primary); white-space: pre-wrap; min-height: 120px;">
              No announcements from project managers yet.
            </div>
          </div>
        </div>
      </div>

      <!-- VIEW: Submit New Request -->
      <div id="view-submit" class="client-view hidden">
        <div class="workspace-header-bar">
          <div>
            <h2>Submit New Request</h2>
            <p class="subtitle">Submit complaints, bug reports, or feature requests.</p>
          </div>
        </div>

        <div style="max-width: 800px; margin-top: 20px; background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
          <!-- Dynamic Request Info Box -->
          <div style="background-color: #f1f5f9; border-radius: 8px; padding: 12px 16px; margin-bottom: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; border: 1px solid var(--border-color);">
            <div>
              <span style="font-size: 11px; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Request Sequence Number</span>
              <div id="request-seq-num" style="font-size: 16px; font-weight: 700; color: #0f172a; margin-top: 2px;">#...</div>
            </div>
            <div>
              <span style="font-size: 11px; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Date & Time</span>
              <div id="request-datetime" style="font-size: 15px; font-weight: 600; color: #0f172a; margin-top: 2px;">-</div>
            </div>
          </div>

          <form id="inline-complaint-form" class="complaint-form">
            <!-- Category Selector -->
            <div class="form-group" style="margin-bottom: 20px;">
              <label for="inline-category" style="display: block; font-weight: 600; margin-bottom: 8px; color: var(--text-primary);">Category</label>
              <select id="inline-category" class="form-control-select" style="width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 8px; background-color: #f8fafc;" required>
                <option value="" disabled selected>-- Select Category --</option>
                <option value="UI Bug">UI Bug</option>
                <option value="Feature Request">Feature Request</option>
                <option value="Design Change">Design Change</option>
              </select>
            </div>

            <!-- Title -->
            <div class="form-group" style="margin-bottom: 20px;">
              <label for="inline-title" style="display: block; font-weight: 600; margin-bottom: 8px; color: var(--text-primary);">Request Title</label>
              <input 
                type="text" 
                id="inline-title" 
                placeholder="e.g. UI Bug - Request #3" 
                class="form-control-input" 
                style="width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 8px; background-color: #f8fafc; font-family: inherit;"
                required
              />
            </div>

            <!-- Description -->
            <div class="form-group" style="margin-bottom: 20px;">
              <label for="inline-description" style="display: block; font-weight: 600; margin-bottom: 8px; color: var(--text-primary);">Explanation / Description (Optional if files attached)</label>
              <textarea 
                id="inline-description" 
                rows="5" 
                placeholder="Write description/details of your complaint here, or add any notes..." 
                class="form-control-textarea" 
                style="width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 8px; background-color: #f8fafc; font-family: inherit; resize: vertical;"
              ></textarea>
            </div>

            <!-- Upload / Capture Mode Selector -->
            <div class="form-group" style="margin-bottom: 24px;">
              <label style="display: block; font-weight: 600; margin-bottom: 8px; color: var(--text-primary);">Attachments / Support Media (Optional if description is provided)</label>
              
              <!-- Tab Mode Buttons -->
              <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 12px;" class="upload-type-selector">
                <button type="button" class="btn btn-secondary active-mode-btn" id="mode-video" style="padding: 8px; font-size: 11.5px; display: flex; flex-direction: column; align-items: center; gap: 4px; border: 1px solid #2563eb; background: #eff6ff; color: #2563eb; cursor: pointer; border-radius: 6px;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 8-6 4 6 4V8Z"></path><rect width="14" height="12" x="2" y="6" rx="2" ry="2"></rect></svg>
                  <span>Video</span>
                </button>
                <button type="button" class="btn btn-secondary" id="mode-image" style="padding: 8px; font-size: 11.5px; display: flex; flex-direction: column; align-items: center; gap: 4px; border: 1px solid #cbd5e1; background: #fff; color: #475569; cursor: pointer; border-radius: 6px;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
                  <span>Photo</span>
                </button>
                <button type="button" class="btn btn-secondary" id="mode-audio" style="padding: 8px; font-size: 11.5px; display: flex; flex-direction: column; align-items: center; gap: 4px; border: 1px solid #cbd5e1; background: #fff; color: #475569; cursor: pointer; border-radius: 6px;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
                  <span>Audio File</span>
                </button>
                <button type="button" class="btn btn-secondary" id="mode-record" style="padding: 8px; font-size: 11.5px; display: flex; flex-direction: column; align-items: center; gap: 4px; border: 1px solid #cbd5e1; background: #fff; color: #475569; cursor: pointer; border-radius: 6px;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line></svg>
                  <span>Record Voice</span>
                </button>
              </div>

              <!-- File Select Dropzone Container -->
              <div class="dropzone" id="inline-dropzone" style="border: 2px dashed var(--border-color); border-radius: 12px; padding: 28px; text-align: center; cursor: pointer; background-color: #f8fafc; position: relative;">
                <input type="file" id="inline-video-file" accept="video/*" class="hidden-file-input" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;" />
                <svg id="dropzone-media-icon" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-secondary); margin: 0 auto 12px;"><path d="m22 8-6 4 6 4V8Z"></path><rect width="14" height="12" x="2" y="6" rx="2" ry="2"></rect></svg>
                <div class="dropzone-text" id="dropzone-media-text">
                  <span class="highlight" style="color: var(--primary); font-weight: 600;">Click to select video</span> or drag-and-drop
                  <p class="formats" id="dropzone-media-formats" style="font-size: 12px; color: var(--text-secondary); margin-top: 4px;">MP4, MOV, AVI (Max. 100MB)</p>
                </div>
              </div>

              <!-- Audio Recorder Panel -->
              <div id="audio-recorder-panel" class="hidden" style="border: 1px solid #cbd5e1; border-radius: 12px; padding: 20px; background-color: #f8fafc; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px;">
                <div id="recorder-status" style="font-size: 13.5px; font-weight: 600; color: #475569;">Ready to record audio</div>
                <div id="recording-timer" class="hidden" style="font-size: 24px; font-weight: 700; color: #ef4444; font-family: monospace;">00:00</div>
                <div style="display: flex; gap: 10px; justify-content: center;">
                  <button type="button" class="btn btn-primary" id="start-record-btn" style="background-color: #ef4444; border-color: #ef4444; color: white; display: flex; align-items: center; gap: 6px; cursor: pointer; padding: 8px 16px; border-radius: 6px;">
                    <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background-color: white;"></span>
                    <span>Start Recording</span>
                  </button>
                  <button type="button" class="btn btn-secondary hidden" id="stop-record-btn" style="background-color: #475569; border-color: #475569; color: white; cursor: pointer; padding: 8px 16px; border-radius: 6px;">
                    Stop Recording
                  </button>
                </div>
                <div id="audio-preview-container" class="hidden" style="width: 100%; display: flex; flex-direction: column; align-items: center; gap: 8px;">
                  <span style="font-size: 12px; color: #64748b; font-weight: 600;">Listen to your recording:</span>
                  <audio id="audio-preview" controls style="width: 100%; max-width: 320px;"></audio>
                </div>
              </div>

              <!-- List of uploaded files -->
              <div id="uploaded-files-list-container" class="hidden" style="margin-top: 16px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px; background-color: #ffffff;">
                <div style="font-size: 12.5px; font-weight: 700; color: #334155; margin-bottom: 8px;">Uploaded Attachments:</div>
                <div id="uploaded-files-list" style="display: flex; flex-direction: column; gap: 8px;">
                  <!-- Dynamic file items -->
                </div>
              </div>
            </div>

            <!-- Error Banner -->
            <div id="inline-submit-error" class="error-banner hidden" style="color: #ef4444; font-size: 13.5px; font-weight: 600; margin-bottom: 16px;"></div>

            <!-- Submit Button -->
            <div style="display: flex; justify-content: flex-end;">
              <button type="submit" class="btn btn-primary" id="inline-submit-btn" style="padding: 10px 20px;">
                <svg class="animate-spin mr-2 hidden" id="inline-submit-loader" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite; margin-right: 8px;"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line></svg>
                <span id="inline-btn-text">Submit Request</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- VIEW: Settings & Security -->
      <div id="view-settings" class="client-view hidden">
        <div class="workspace-header-bar">
          <div>
            <h2>Settings & Device Security</h2>
            <p class="subtitle">Manage your login sessions and active devices.</p>
          </div>
        </div>

        <div class="settings-content-layout">
          <div class="security-card">
            <div class="security-header">
              <h3>Device Session Limits</h3>
              <span class="badge status-secured">Active Protection</span>
            </div>
            <p>To secure your client portal, active logins are limited to a maximum of <strong>2 devices</strong> simultaneously. Attempting to log in on a third device will be blocked until you log out of an existing session.</p>
            
            <div class="device-limit-gauge">
              <div class="gauge-bar">
                <div class="gauge-fill" id="session-gauge-fill" style="width: 50%;"></div>
              </div>
              <div class="gauge-label">
                <span id="session-count-label">1 / 2 Devices Active</span>
              </div>
            </div>
          </div>

          <div class="sessions-list-card">
            <div class="card-header-row">
              <h3>Logged In Devices</h3>
              <button class="btn btn-secondary btn-sm" id="logout-other-devices-btn">
                <span>Logout Other Devices</span>
              </button>
            </div>
            
            <div class="sessions-table-wrapper">
              <table class="excel-table">
                <thead>
                  <tr>
                    <th>Device Details (Session Identifier)</th>
                    <th>Last Active</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="sessions-list-body">
                  <tr>
                    <td colspan="3" style="text-align: center; padding: 16px;">Loading sessions...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- Video Player Modal -->
  <div class="modal-overlay hidden" id="video-player-modal" style="z-index: 110;">
    <div class="modal-card" style="max-width: 800px; width: 100%; border-radius: 12px; overflow: hidden; background-color: #000000; border: 1px solid #334155;">
      <div class="modal-header" style="background-color: #0f172a; border-bottom: 1px solid #1e293b;">
        <h2 id="video-modal-title" style="color: #ffffff;">Video Player</h2>
        <button class="close-btn" id="close-video-modal-btn" style="color: #94a3b8;">&times;</button>
      </div>
      <div id="video-player-container" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; background-color: #000000;">
        <!-- Dynamically populated video element -->
      </div>
    </div>
  </div>

  <!-- Complaint Modal -->
  <div class="modal-overlay hidden" id="complaint-modal">
    <div class="modal-card">
      <div class="modal-header">
        <h2 id="modal-title">Submit Complaint / Change Request</h2>
        <button class="close-btn" id="close-modal-btn">&times;</button>
      </div>

      <form id="complaint-form" class="complaint-form">
        <input type="hidden" id="complaint-id-input" />
        <!-- Category Selector -->
        <div class="form-group">
          <label for="category">Category</label>
          <select id="category" class="form-control-select" required>
            <option value="" disabled selected>-- Select a category --</option>
            <option value="UI Bug">UI Bug</option>
            <option value="Feature Request">Feature Request</option>
            <option value="Design Change">Design Change</option>
          </select>
        </div>

        <!-- Description -->
        <div class="form-group">
          <label for="description">Explanation / Complaint Details</label>
          <textarea 
            id="description" 
            rows="4" 
            placeholder="Describe the bug, issue or the change request you need in detail..." 
            class="form-control-textarea" 
            required
          ></textarea>
        </div>

        <!-- Video upload -->
        <div class="form-group">
          <label>Upload Video Complaint</label>
          <div class="dropzone" id="dropzone">
            <input type="file" id="video-file" accept="video/*" class="hidden-file-input" />
            <Video size={36} class="dropzone-icon" />
            <div class="dropzone-text">
              <span class="highlight">Click to select video</span> or drag and drop
              <p class="formats">MP4, MOV, AVI up to 100MB</p>
            </div>
            <div id="file-selected-indicator" class="file-selected-indicator hidden">
              <FileVideo size={20} class="indicator-icon" />
              <span id="selected-file-name" class="filename">video.mp4</span>
            </div>
          </div>
        </div>

        <!-- Submit Buttons -->
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" id="cancel-modal-btn">Cancel</button>
          <button type="submit" class="btn btn-primary" id="submit-btn">
            <Loader2 size={16} class="animate-spin mr-2 hidden" id="submit-loader" />
            <span id="btn-text">Submit Request</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<style>
