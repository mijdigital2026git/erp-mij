---
import Layout from '../layouts/Layout.astro';
import { 
  Users, 
  FileText, 
  CheckCircle, 
  Clock, 
  AlertCircle, 
  Loader2, 
  LogOut, 
  ExternalLink, 
  FileVideo, 
  Search,
  UserCheck,
  Send,
  Upload,
  Image as ImageIcon,
  Check,
  Briefcase,
  KeyRound
} from '@lucide/astro';

const user = (Astro.locals as any).user;
if (!user) {
  return Astro.redirect('/login');
}
---

<Layout>
  <head>
    <title>Admin Workspace - MIJ ERP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <div class="app-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="logo-area">
        <div class="logo-icon">M</div>
        <h2>MIJ<span>ERP</span></h2>
      </div>

      <div class="client-badge">
        <span class="label">Logged in as</span>
        <span class="name">{user.name}</span>
        <span class="role-badge admin">System Admin</span>
      </div>

      <nav class="nav-menu">
        <button class="nav-item active" id="tab-clients">
          <Users size={20} class="icon" />
          <span>Client Database</span>
        </button>
        <button class="nav-item" id="tab-users">
          <KeyRound size={20} class="icon" />
          <span>Manage Passwords</span>
        </button>
      </nav>

      <div class="sidebar-footer">
        <a href="/api/logout" class="nav-item logout-btn">
          <LogOut size={20} />
          <span>Logout</span>
        </a>
      </div>
    </aside>

    <!-- Main Workspace -->
    <main class="main-content">
      <!-- Clients Workspace -->
      <div id="workspace-clients">
        <div class="admin-workspace-grid">
          
          <!-- Left Column: Client List -->
          <section class="card clients-list-card">
            <div class="card-header-search">
              <h2>Clients Directory</h2>
              <p class="subtitle">Select a client below to view their detailed complaint files and task pengerjaan.</p>
              <div class="search-box">
                <Search size={16} class="search-icon" />
                <input type="text" id="client-search" placeholder="Search clients..." class="form-control" />
              </div>
            </div>

            <div class="clients-list-container">
              <div class="loading-state" id="clients-loading">
                <Loader2 size={24} class="animate-spin" />
                <p>Fetching clients...</p>
              </div>
              
              <div class="clients-list hidden" id="clients-list">
                <!-- Dynamically populated -->
              </div>
            </div>
          </section>

          <!-- Right Column: Selected Client Complaints / Task Detail -->
          <section class="card client-details-card">
            <!-- Default State: No Client Selected -->
            <div class="empty-workspace-state" id="no-client-selected-state">
              <Briefcase size={56} class="empty-icon" />
              <h3>No Client Selected</h3>
              <p>Select a client from the directory list on the left to view and edit their task lists, update statuses, write conclusions, and upload change photos.</p>
            </div>

            <!-- Active State: Client Details Panel -->
            <div class="client-details-panel hidden" id="client-details-panel">
              <div class="client-detail-header">
                <div class="detail-name-area">
                  <h2 id="detail-client-name">PT Maju Jaya</h2>
                  <div class="client-meta-info">
                    <span>Code: <code id="detail-client-code">CLIENT123</code></span>
                  </div>
                </div>
                <span class="badge secondary" id="detail-client-task-count">0 Complaints</span>
              </div>

              <!-- Task/Complaint Category Filters -->
              <div class="detail-filters">
                <button class="filter-btn active" data-category="all">All Category</button>
                <button class="filter-btn" data-category="UI Bug">UI Bug</button>
                <button class="filter-btn" data-category="Feature Request">Feature Request</button>
                <button class="filter-btn" data-category="Design Change">Design Change</button>
              </div>

              <!-- Client Tasks List -->
              <div class="detail-tasks-container">
                <div class="loading-state hidden" id="tasks-loading">
                  <Loader2 size={28} class="animate-spin" />
                  <p>Loading client tasks...</p>
                </div>

                <div class="detail-empty-state hidden" id="tasks-empty-state">
                  <CheckCircle size={40} class="empty-icon" />
                  <h3>No Tasks Found</h3>
                  <p>This client has no complaints filed under this category.</p>
                </div>

                <div class="client-tasks-accordion" id="client-tasks-accordion">
                  <!-- Dynamically populated tasks -->
                </div>
              </div>
            </div>
          </section>

        </div>
      </div>

      <!-- User Password Management Workspace -->
      <div id="workspace-users" class="hidden">
        <section class="card users-card">
          <div class="card-header" style="border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 20px;">
            <h2>Manage User Access Codes</h2>
            <p class="subtitle">View and edit authorization codes / login passwords for all system users.</p>
          </div>
          
          <div class="users-table-container">
            <table class="users-table">
              <thead>
                <tr>
                  <th style="padding-bottom: 12px;">Name</th>
                  <th style="padding-bottom: 12px;">Role</th>
                  <th style="padding-bottom: 12px;">Access Code</th>
                  <th style="padding-bottom: 12px;">Actions</th>
                </tr>
              </thead>
              <tbody id="users-list-body">
                <!-- Dynamically populated -->
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </main>
  </div>
</Layout>

<style>
  :root {
    --bg-dark: #09090b;
    --bg-card: #18181b;
    --bg-card-hover: #27272a;
    --border-color: #27272a;
    --text-primary: #f4f4f5;
    --text-secondary: #a1a1aa;
    --primary: #8b5cf6;
    --primary-hover: #7c3aed;
    --primary-glow: rgba(139, 92, 246, 0.15);
    
    --success: #10b981;
    --success-bg: rgba(16, 185, 129, 0.1);
    --warning: #f59e0b;
    --warning-bg: rgba(245, 158, 11, 0.1);
    --danger: #ef4444;
    --danger-bg: rgba(239, 68, 68, 0.1);

    --font-heading: 'Plus Jakarta Sans', sans-serif;
    --font-body: 'Outfit', sans-serif;
  }

  body {
    background-color: var(--bg-dark);
    color: var(--text-primary);
    font-family: var(--font-body);
    margin: 0;
  }

  .app-container {
    display: flex;
    min-height: 100vh;
  }

  /* Sidebar styling */
  .sidebar {
    width: 260px;
    background-color: #0c0c0e;
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    padding: 24px;
    box-sizing: border-box;
    position: fixed;
    height: 100vh;
    z-index: 10;
  }

  .logo-area {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 30px;
  }

  .logo-icon {
    background: linear-gradient(135deg, var(--primary), #a78bfa);
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 20px;
    color: white;
  }

  .logo-area h2 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 20px;
    margin: 0;
    letter-spacing: -0.5px;
  }

  .logo-area h2 span {
    color: var(--primary);
  }

  .client-badge {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 30px;
  }

  .client-badge .label {
    font-size: 11px;
    color: var(--text-secondary);
    text-transform: uppercase;
    font-weight: 600;
  }

  .client-badge .name {
    font-size: 15px;
    font-weight: 700;
  }

  .client-badge .role-badge.admin {
    background-color: rgba(239, 68, 68, 0.15);
    color: #fca5a5;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    align-self: flex-start;
    margin-top: 4px;
  }

  .nav-menu {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .nav-item {
    background: transparent;
    border: none;
    outline: none;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 15px;
    text-align: left;
    border-radius: 8px;
    cursor: pointer;
    width: 100%;
    box-sizing: border-box;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .nav-item:hover {
    color: var(--text-primary);
    background-color: rgba(255, 255, 255, 0.03);
  }

  .nav-item.active {
    color: white;
    background-color: var(--primary);
    box-shadow: 0 4px 15px var(--primary-glow);
  }

  .logout-btn {
    color: var(--danger);
  }

  .logout-btn:hover {
    background-color: var(--danger-bg);
    color: var(--danger);
  }

  .sidebar-footer {
    padding-top: 16px;
    border-top: 1px solid var(--border-color);
  }

  /* Main Workspace Grid styling */
  .main-content {
    flex-grow: 1;
    margin-left: 260px;
    padding: 30px;
    box-sizing: border-box;
    max-width: 1350px;
  }

  .admin-workspace-grid {
    display: grid;
    grid-template-columns: 350px 1fr;
    gap: 24px;
    height: calc(100vh - 60px);
  }

  .card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 24px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Clients List Card */
  .card-header-search {
    margin-bottom: 20px;
    flex-shrink: 0;
  }

  .card-header-search h2 {
    margin: 0 0 6px 0;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
  }

  .card-header-search .subtitle {
    margin: 0 0 16px 0;
    font-size: 13px;
    line-height: 1.4;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    color: var(--text-secondary);
  }

  .search-box .form-control {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--border-color);
    padding: 8px 12px 8px 36px;
    border-radius: 8px;
    color: white;
    font-family: var(--font-body);
    font-size: 13px;
    box-sizing: border-box;
  }

  .search-box .form-control:focus {
    border-color: var(--primary);
    outline: none;
  }

  .clients-list-container {
    flex-grow: 1;
    overflow-y: auto;
  }

  .clients-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .client-item {
    background-color: rgba(255, 255, 255, 0.01);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .client-item:hover {
    border-color: rgba(139, 92, 246, 0.3);
    background-color: rgba(139, 92, 246, 0.02);
  }

  .client-item.active {
    background-color: var(--primary-glow);
    border-color: var(--primary);
  }

  .client-item-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .client-item-info h4 {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }

  .client-item-info span {
    font-size: 11px;
    color: var(--text-secondary);
  }

  /* Task Count Badge */
  .badge {
    padding: 4px 8px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
  }

  .badge.secondary {
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--text-secondary);
  }

  /* Empty Workspace State */
  .empty-workspace-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
    padding: 40px;
    color: var(--text-secondary);
  }

  .empty-icon {
    color: #27272a;
    margin-bottom: 16px;
  }

  .empty-workspace-state h3 {
    margin: 0 0 6px 0;
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .empty-workspace-state p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    max-width: 450px;
  }

  /* Active Client Details Panel */
  .client-details-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .client-detail-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-color);
    flex-shrink: 0;
  }

  .detail-name-area h2 {
    margin: 0 0 4px 0;
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
  }

  .client-meta-info {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .client-meta-info code {
    background-color: rgba(255, 255, 255, 0.05);
    padding: 2px 6px;
    border-radius: 4px;
    color: #c084fc;
    font-family: monospace;
  }

  .detail-filters {
    display: flex;
    gap: 8px;
    margin: 16px 0;
    flex-shrink: 0;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 6px 12px;
    border-radius: 20px;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    border-color: var(--text-secondary);
  }

  .filter-btn.active {
    background-color: var(--primary-glow);
    border-color: var(--primary);
    color: #c084fc;
  }

  .detail-tasks-container {
    flex-grow: 1;
    overflow-y: auto;
    padding-right: 4px;
  }

  /* Accordion Tasks list */
  .client-tasks-accordion {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .accordion-item {
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.01);
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .accordion-item.open {
    border-color: rgba(139, 92, 246, 0.4);
    background-color: rgba(255, 255, 255, 0.02);
  }

  .accordion-header {
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }

  .accordion-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .accordion-category {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
  }

  .accordion-status-badge {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .accordion-status-badge.proses { background-color: var(--warning-bg); color: var(--warning); }
  .accordion-status-badge.review { background-color: rgba(59, 130, 246, 0.1); color: #3b82f6; }
  .accordion-status-badge.selesai { background-color: var(--success-bg); color: var(--success); }

  .accordion-time {
    font-size: 12px;
    color: var(--text-secondary);
  }

  /* Accordion Body */
  .accordion-body {
    padding: 0 20px 20px 20px;
    display: none;
    flex-direction: column;
    gap: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    margin-top: -1px;
    animation: slideDown 0.25s ease-out;
  }

  .accordion-item.open .accordion-body {
    display: flex;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .accordion-desc {
    font-size: 14.5px;
    line-height: 1.6;
    margin: 16px 0 0 0;
    color: #e4e4e7;
  }

  /* Links */
  .attachments-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .file-chip {
    background-color: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--border-color);
    padding: 8px 14px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .file-chip:hover {
    border-color: var(--primary);
    color: #c084fc;
    background-color: rgba(139, 92, 246, 0.04);
  }

  .file-chip.image-chip:hover {
    border-color: var(--success);
    color: #34d399;
    background-color: rgba(16, 185, 129, 0.04);
  }

  /* Admin edit controls inside task */
  .admin-edit-panel {
    background-color: rgba(0, 0, 0, 0.15);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .admin-edit-panel h4 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
  }

  .edit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-control-select, 
  .form-control-textarea {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    color: white;
    font-family: var(--font-body);
    font-size: 13.5px;
    box-sizing: border-box;
    padding: 10px;
  }

  .form-control-select:focus,
  .form-control-textarea:focus {
    border-color: var(--primary);
    outline: none;
  }

  /* File Uploader within task */
  .image-uploader-dropzone {
    border: 1px dashed var(--border-color);
    border-radius: 8px;
    padding: 16px;
    text-align: center;
    background-color: rgba(0, 0, 0, 0.1);
    position: relative;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .image-uploader-dropzone:hover {
    border-color: var(--success);
    background-color: rgba(16, 185, 129, 0.02);
  }

  .image-uploader-dropzone .icon {
    color: var(--text-secondary);
    margin-bottom: 6px;
    transition: transform 0.2s ease;
  }

  .image-uploader-dropzone:hover .icon {
    transform: translateY(-2px);
    color: var(--success);
  }

  .uploader-text {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .uploader-text .highlight {
    color: var(--success);
    font-weight: 600;
  }

  .uploader-file-indicator {
    font-size: 11px;
    font-weight: 500;
    color: var(--success);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin-top: 4px;
  }

  /* Save buttons */
  .panel-action-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 4px;
  }

  /* Buttons */
  .btn {
    border: none;
    outline: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: var(--primary);
    color: white;
  }

  .btn-primary:hover {
    background-color: var(--primary-hover);
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
  }

  .btn-success {
    background-color: var(--success);
    color: white;
  }

  .btn-success:hover {
    background-color: #059669;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  }

  /* Loading states */
  .loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 10px;
    color: var(--text-secondary);
    gap: 8px;
  }

  .detail-empty-state {
    text-align: center;
    padding: 80px 20px;
    color: var(--text-secondary);
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }

  .mr-2 { margin-right: 6px; }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .hidden {
    display: none !important;
  }

  /* Users management styling */
  .users-card {
    padding: 24px;
  }

  .users-table-container {
    overflow-x: auto;
    margin-top: 20px;
  }

  .users-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .users-table th {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 600;
  }

  .users-table td {
    padding: 16px;
    border-bottom: 1px solid var(--border-color);
    font-size: 14px;
    vertical-align: middle;
  }

  .users-table tr:hover {
    background-color: rgba(255, 255, 255, 0.01);
  }

  .user-role-badge {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    display: inline-block;
  }

  .user-role-badge.admin {
    background-color: rgba(139, 92, 246, 0.15);
    color: #c084fc;
  }

  .user-role-badge.client {
    background-color: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
  }

  .user-code-input {
    background-color: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: white;
    padding: 6px 12px;
    font-family: monospace;
    font-size: 13px;
    width: 160px;
    box-sizing: border-box;
  }

  .user-code-input:focus {
    border-color: var(--primary);
    outline: none;
  }

  .user-code-display {
    font-family: monospace;
    font-size: 14px;
    color: #f4f4f5;
  }

  .btn-secondary {
    background-color: var(--bg-card-hover);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }

  .btn-sm {
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 6px;
  }
</style>

<script>
  let clients: any[] = [];
  let currentTasks: any[] = [];
  let selectedClient: any = null;
  
  let currentFilter = 'all';
  let clientSearchQuery = '';

  const clientsLoading = document.getElementById('clients-loading');
  const clientsList = document.getElementById('clients-list');
  const clientSearch = document.getElementById('client-search') as HTMLInputElement;

  const noClientState = document.getElementById('no-client-selected-state');
  const detailsPanel = document.getElementById('client-details-panel');

  const detailClientName = document.getElementById('detail-client-name');
  const detailClientCode = document.getElementById('detail-client-code');
  const detailClientTaskCount = document.getElementById('detail-client-task-count');
  
  const tasksLoading = document.getElementById('tasks-loading');
  const tasksEmptyState = document.getElementById('tasks-empty-state');
  const accordionContainer = document.getElementById('client-tasks-accordion');

  // Load clients list
  async function loadClients() {
    if (clientsLoading) clientsLoading.classList.remove('hidden');
    if (clientsList) clientsList.classList.add('hidden');

    try {
      const response = await fetch('/api/clients');
      const data = await response.json();
      
      if (clientsLoading) clientsLoading.classList.add('hidden');

      if (response.ok && data.success) {
        clients = data.clients;
        renderClients();
      } else {
        alert(`Failed to load clients: ${data.error}`);
      }
    } catch (err: any) {
      if (clientsLoading) clientsLoading.classList.add('hidden');
      alert(`Network error loading clients: ${err.message}`);
    }
  }

  function renderClients() {
    if (!clientsList) return;

    let filteredClients = clients;
    if (clientSearchQuery) {
      const query = clientSearchQuery.toLowerCase();
      filteredClients = clients.filter(c => c.name.toLowerCase().includes(query));
    }

    if (filteredClients.length === 0) {
      clientsList.innerHTML = '<p class="text-sm text-secondary" style="padding: 10px;">No clients found.</p>';
      clientsList.classList.remove('hidden');
      return;
    }

    clientsList.innerHTML = filteredClients.map(client => {
      const isActive = selectedClient && selectedClient.id === client.id;
      return `
        <div class="client-item ${isActive ? 'active' : ''}" data-client-id="${client.id}">
          <div class="client-item-info">
            <h4>${client.name}</h4>
            <span>Code: ${client.code}</span>
          </div>
          <span class="badge secondary">${client.task_count} task${client.task_count !== 1 ? 's' : ''}</span>
        </div>
      `;
    }).join('');

    clientsList.classList.remove('hidden');

    // Bind click events to client items
    const clientItems = document.querySelectorAll('.client-item');
    clientItems.forEach(item => {
      item.addEventListener('click', () => {
        const clientId = item.getAttribute('data-client-id');
        const client = clients.find(c => c.id === clientId);
        if (client) {
          selectClient(client);
        }
      });
    });
  }

  // Select client and load their task history
  async function selectClient(client: any) {
    selectedClient = client;
    renderClients(); // updates active item highlighting

    if (noClientState) noClientState.classList.add('hidden');
    if (detailsPanel) detailsPanel.classList.remove('hidden');

    if (detailClientName) detailClientName.textContent = client.name;
    if (detailClientCode) detailClientCode.textContent = client.code;
    if (detailClientTaskCount) detailClientTaskCount.textContent = `${client.task_count} Task${client.task_count !== 1 ? 's' : ''}`;

    loadClientTasks();
  }

  async function loadClientTasks() {
    if (!selectedClient) return;

    if (tasksLoading) tasksLoading.classList.remove('hidden');
    if (tasksEmptyState) tasksEmptyState.classList.add('hidden');
    if (accordionContainer) accordionContainer.classList.add('hidden');

    try {
      // Re-fetch all tasks (we will filter client-side for simplicity)
      const response = await fetch('/api/tasks');
      const data = await response.json();

      if (tasksLoading) tasksLoading.classList.add('hidden');

      if (response.ok && data.success) {
        // Filter tasks belonging only to the selected client
        currentTasks = data.tasks.filter((t: any) => t.client_id === selectedClient.id);
        renderClientTasks();
      } else {
        alert(`Failed to load tasks: ${data.error}`);
      }
    } catch (err: any) {
      if (tasksLoading) tasksLoading.classList.add('hidden');
      alert(`Network error loading tasks: ${err.message}`);
    }
  }

  function renderClientTasks() {
    if (!accordionContainer || !tasksEmptyState) return;

    // Filter by Category
    const filteredTasks = currentFilter === 'all' 
      ? currentTasks 
      : currentTasks.filter(t => t.category === currentFilter);

    if (filteredTasks.length === 0) {
      accordionContainer.innerHTML = '';
      tasksEmptyState.classList.remove('hidden');
      return;
    }

    tasksEmptyState.classList.add('hidden');
    
    accordionContainer.innerHTML = filteredTasks.map(task => {
      const formattedDate = new Date(task.created_at).toLocaleString('id-ID', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      });

      return `
        <div class="accordion-item" id="task-item-${task.id}">
          <div class="accordion-header" data-task-id="${task.id}">
            <div class="accordion-header-left">
              <span class="accordion-status-badge ${task.status}">${task.status}</span>
              <span class="accordion-category">${task.category}</span>
            </div>
            <div class="accordion-time">
              <span>${formattedDate}</span>
            </div>
          </div>
          
          <div class="accordion-body">
            <p class="accordion-desc">${task.description}</p>
            
            <div class="attachments-row">
              ${task.video_url ? `
                <a href="${task.video_url}" target="_blank" class="file-chip">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 8-6 4 6 4V8Z"></path><rect width="14" height="12" x="2" y="6" rx="2" ry="2"></rect></svg>
                  <span>Video Complaint</span>
                </a>
              ` : ''}

              ${task.image_url ? `
                <a href="${task.image_url}" target="_blank" class="file-chip image-chip">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
                  <span>View Change (Photo)</span>
                </a>
              ` : ''}
            </div>

            <!-- Admin Update Panel -->
            <form class="admin-edit-panel" data-task-id="${task.id}">
              <h4>Admin Task Control</h4>
              
              <div class="edit-grid">
                <!-- Status Select -->
                <div class="form-group">
                  <label for="status-${task.id}">Status pengerjaan</label>
                  <select id="status-${task.id}" class="form-control-select">
                    <option value="proses" ${task.status === 'proses' ? 'selected' : ''}>Proses</option>
                    <option value="review" ${task.status === 'review' ? 'selected' : ''}>Review</option>
                    <option value="selesai" ${task.status === 'selesai' ? 'selected' : ''}>Selesai</option>
                  </select>
                </div>
                
                <!-- Image Upload (Verification Photo) -->
                <div class="form-group">
                  <label>Upload Verification Photo</label>
                  <div class="image-uploader-dropzone" id="image-dropzone-${task.id}">
                    <input type="file" id="image-file-${task.id}" accept="image/*" class="hidden-file-input" />
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
                    <div class="uploader-text">
                      <span class="highlight">Click to select photo</span>
                    </div>
                    <div class="uploader-file-indicator hidden" id="image-indicator-${task.id}">
                      <span id="image-name-${task.id}">photo.png</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Conclusion -->
              <div class="form-group">
                <label for="conclusion-${task.id}">Kesimpulan Perubahan (Conclusion of Change)</label>
                <textarea 
                  id="conclusion-${task.id}" 
                  rows="3" 
                  placeholder="Provide a summary of the fixes, changes, or resolutions implemented..." 
                  class="form-control-textarea"
                >${task.conclusion || ''}</textarea>
              </div>

              <!-- Save Actions -->
              <div class="panel-action-row">
                <button type="submit" class="btn btn-success" id="save-btn-${task.id}">
                  <svg class="animate-spin mr-2 hidden loader" id="loader-${task.id}" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" x2="12" y1="2" y2="6"></line><line x1="12" x2="12" y1="18" y2="22"></line><line x1="4.93" x2="7.76" y1="4.93" y2="7.76"></line><line x1="16.24" x2="19.07" y1="16.24" y2="19.07"></line><line x1="2" x2="6" y1="12" y2="12"></line><line x1="18" x2="22" y1="12" y2="12"></line><line x1="4.93" x2="7.76" y1="19.07" y2="16.24"></line><line x1="16.24" x2="19.07" y1="7.76" y2="4.93"></line></svg>
                  <span class="btn-text">Save Resolutions</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      `;
    }).join('');

    accordionContainer.classList.remove('hidden');

    // Bind Accordion Toggling
    const headers = document.querySelectorAll('.accordion-header');
    headers.forEach(header => {
      header.addEventListener('click', () => {
        const taskId = header.getAttribute('data-task-id');
        const item = document.getElementById(`task-item-${taskId}`);
        if (item) {
          item.classList.toggle('open');
        }
      });
    });

    // Bind File Input Indicators inside form
    filteredTasks.forEach(task => {
      const fileInput = document.getElementById(`image-file-${task.id}`) as HTMLInputElement;
      const indicator = document.getElementById(`image-indicator-${task.id}`);
      const fileNameSpan = document.getElementById(`image-name-${task.id}`);
      
      if (fileInput && indicator && fileNameSpan) {
        fileInput.addEventListener('change', () => {
          if (fileInput.files && fileInput.files.length > 0) {
            fileNameSpan.textContent = fileInput.files[0].name;
            indicator.classList.remove('hidden');
          } else {
            indicator.classList.add('hidden');
          }
        });
      }
    });

    // Bind Form Submissions
    const forms = document.querySelectorAll('.admin-edit-panel');
    forms.forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const taskId = form.getAttribute('data-task-id')!;
        const statusSelect = document.getElementById(`status-${taskId}`) as HTMLSelectElement;
        const conclusionTextarea = document.getElementById(`conclusion-${taskId}`) as HTMLTextAreaElement;
        const fileInput = document.getElementById(`image-file-${taskId}`) as HTMLInputElement;
        
        const saveBtn = document.getElementById(`save-btn-${taskId}`) as HTMLButtonElement;
        const loader = document.getElementById(`loader-${taskId}`);
        
        saveBtn.disabled = true;
        if (loader) loader.classList.remove('hidden');

        const formData = new FormData();
        formData.append('status', statusSelect.value);
        formData.append('conclusion', conclusionTextarea.value);
        
        if (fileInput && fileInput.files && fileInput.files.length > 0) {
          formData.append('image', fileInput.files[0]);
        }

        try {
          const response = await fetch(`/api/tasks/${taskId}`, {
            method: 'PATCH',
            body: formData
          });

          const data = await response.json();
          
          saveBtn.disabled = false;
          if (loader) loader.classList.add('hidden');

          if (response.ok && data.success) {
            alert('Task resolutions updated successfully!');
            // Reload task statistics and task list
            loadClients();
            loadClientTasks();
          } else {
            alert(`Failed to save: ${data.error}`);
          }
        } catch (err: any) {
          saveBtn.disabled = false;
          if (loader) loader.classList.add('hidden');
          alert(`Network error saving task: ${err.message}`);
        }
      });
    });
  }

  // Filter Categories
  const filterBtns = document.querySelectorAll('.filter-btn');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.getAttribute('data-category') || 'all';
      renderClientTasks();
    });
  });

  // Client Search input listener
  if (clientSearch) {
    clientSearch.addEventListener('input', (e) => {
      clientSearchQuery = (e.target as HTMLInputElement).value;
      renderClients();
    });
  }

  // Tab Switching Logic
  const tabClients = document.getElementById('tab-clients');
  const tabUsers = document.getElementById('tab-users');
  const workspaceClients = document.getElementById('workspace-clients');
  const workspaceUsers = document.getElementById('workspace-users');

  if (tabClients && tabUsers && workspaceClients && workspaceUsers) {
    tabClients.addEventListener('click', () => {
      tabClients.classList.add('active');
      tabUsers.classList.remove('active');
      workspaceClients.classList.remove('hidden');
      workspaceUsers.classList.add('hidden');
    });

    tabUsers.addEventListener('click', () => {
      tabUsers.classList.add('active');
      tabClients.classList.remove('active');
      workspaceUsers.classList.remove('hidden');
      workspaceClients.classList.add('hidden');
      loadUsers();
    });
  }

  // Load and Render Users
  let usersList: any[] = [];
  const usersListBody = document.getElementById('users-list-body');

  async function loadUsers() {
    if (!usersListBody) return;
    usersListBody.innerHTML = '<tr><td colspan="4" style="text-align: center; padding: 24px;"><p>Loading users...</p></td></tr>';

    try {
      const response = await fetch('/api/users');
      const data = await response.json();
      
      if (response.ok && data.success) {
        usersList = data.users;
        renderUsers();
      } else {
        alert(`Failed to load users: ${data.error}`);
      }
    } catch (err: any) {
      alert(`Network error loading users: ${err.message}`);
    }
  }

  function renderUsers() {
    if (!usersListBody) return;
    
    if (usersList.length === 0) {
      usersListBody.innerHTML = '<tr><td colspan="4" style="text-align: center; padding: 24px;">No users found.</td></tr>';
      return;
    }

    usersListBody.innerHTML = usersList.map(user => `
      <tr>
        <td style="font-weight: 600; color: #f4f4f5;">${user.name}</td>
        <td>
          <span class="user-role-badge ${user.role}">${user.role}</span>
        </td>
        <td>
          <div id="code-container-${user.id}">
            <span class="user-code-display" id="code-display-${user.id}">${user.code}</span>
            <input type="text" class="user-code-input hidden" id="code-input-${user.id}" value="${user.code}" />
          </div>
        </td>
        <td>
          <div class="actions-container" id="actions-${user.id}">
            <button class="btn btn-secondary btn-sm" onclick="showEditUser('${user.id}')" id="btn-edit-${user.id}">Edit Code</button>
            <button class="btn btn-primary btn-sm hidden" onclick="saveUserCode('${user.id}')" id="btn-save-${user.id}">Save</button>
            <button class="btn btn-secondary btn-sm hidden" onclick="cancelEditUser('${user.id}')" id="btn-cancel-${user.id}" style="margin-left: 6px; display: inline-block;">Cancel</button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  // Expose helper functions globally for inline onclick
  (window as any).showEditUser = (userId: string) => {
    const display = document.getElementById(`code-display-${userId}`);
    const input = document.getElementById(`code-input-${userId}`) as HTMLInputElement;
    const btnEdit = document.getElementById(`btn-edit-${userId}`);
    const btnSave = document.getElementById(`btn-save-${userId}`);
    const btnCancel = document.getElementById(`btn-cancel-${userId}`);

    if (display && input && btnEdit && btnSave && btnCancel) {
      display.classList.add('hidden');
      input.classList.remove('hidden');
      btnEdit.classList.add('hidden');
      btnSave.classList.remove('hidden');
      btnCancel.classList.remove('hidden');
    }
  };

  (window as any).cancelEditUser = (userId: string) => {
    const display = document.getElementById(`code-display-${userId}`);
    const input = document.getElementById(`code-input-${userId}`) as HTMLInputElement;
    const btnEdit = document.getElementById(`btn-edit-${userId}`);
    const btnSave = document.getElementById(`btn-save-${userId}`);
    const btnCancel = document.getElementById(`btn-cancel-${userId}`);

    if (display && input && btnEdit && btnSave && btnCancel) {
      display.classList.remove('hidden');
      input.classList.add('hidden');
      btnEdit.classList.remove('hidden');
      btnSave.classList.add('hidden');
      btnCancel.classList.add('hidden');
      // Reset input value to original
      const user = usersList.find(u => u.id === userId);
      if (user) input.value = user.code;
    }
  };

  (window as any).saveUserCode = async (userId: string) => {
    const input = document.getElementById(`code-input-${userId}`) as HTMLInputElement;
    const btnSave = document.getElementById(`btn-save-${userId}`) as HTMLButtonElement;
    
    if (!input || !btnSave) return;
    const newCode = input.value.trim();

    if (newCode === '') {
      alert('Access code cannot be empty.');
      return;
    }

    btnSave.disabled = true;
    btnSave.textContent = 'Saving...';

    try {
      const response = await fetch(`/api/users/${userId}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ code: newCode })
      });

      const data = await response.json();
      btnSave.disabled = false;
      btnSave.textContent = 'Save';

      if (response.ok && data.success) {
        alert('User access code updated successfully!');
        // Update local state and exit edit mode
        const user = usersList.find(u => u.id === userId);
        if (user) user.code = newCode;
        (window as any).cancelEditUser(userId);
      } else {
        alert(`Error: ${data.error || 'Failed to save access code.'}`);
      }
    } catch (err: any) {
      btnSave.disabled = false;
      btnSave.textContent = 'Save';
      alert(`Network error saving access code: ${err.message}`);
    }
  };

  // Initial load
  loadClients();
</script>
