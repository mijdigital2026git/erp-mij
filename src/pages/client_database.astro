---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import { Loader2, Search } from '@lucide/astro';

const user = (Astro.locals as any).user;
if (!user) {
  return Astro.redirect('/login');
}
if (user.role !== 'admin' && user.role !== 'prof') {
  return Astro.redirect('/dashboard_client');
}
---

<Layout>
  <head>
    <title>Client Database - MIJ ERP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <Sidebar role="admin" />

  <div class="app-container">
    <Header userName={user.name} userRole={user.role} title="Client Database" />

    <!-- Main Content -->
    <main class="main-content-panel">
      <div class="workspace-area">
        <div class="workspace-card" style="background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);">
          
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; gap: 16px; flex-wrap: wrap;">
            <div>
              <h2 style="margin: 0; font-size: 18px; font-weight: 700; color: #0f172a;">Client Accounts Database</h2>
              <p style="margin: 4px 0 0 0; font-size: 13px; color: #64748b;">Manage company accounts, project specs, deadlines, and access codes.</p>
            </div>

            <!-- Search Field -->
            <div class="search-box" style="position: relative; max-width: 320px; width: 100%;">
              <Search size={16} style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #64748b; pointer-events: none;" />
              <input 
                type="text" 
                id="database-client-search" 
                placeholder="Search clients or projects..." 
                style="width: 100%; padding: 8px 12px 8px 36px; border: 1px solid #cbd5e1; border-radius: 8px; font-family: inherit; font-size: 13.5px; box-sizing: border-box;"
              />
            </div>
          </div>

          <!-- Loading Row -->
          <div class="loading-state" id="db-loading-state" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; color: #64748b; gap: 8px;">
            <Loader2 size={28} class="animate-spin" />
            <p>Fetching database records...</p>
          </div>

          <!-- Empty State -->
          <div class="detail-empty-state hidden" id="db-empty-state" style="text-align: center; padding: 60px 20px; color: #64748b;">
            <h3>No Clients Registered</h3>
            <p>Use the "+ Add Client" button at the top header to register a client.</p>
          </div>

          <!-- Excel Table Container -->
          <div class="excel-table-container hidden" id="db-table-container" style="overflow-x: auto; margin-top: 10px; border: 1px solid #e2e8f0; border-radius: 8px;">
            <table class="excel-table">
              <thead>
                <tr>
                  <th style="width: 50px;">No</th>
                  <th>Client / Company Name</th>
                  <th style="width: 130px;">Access Code</th>
                  <th>Contact</th>
                  <th>Project Name</th>
                  <th style="width: 180px;">Project Deadline</th>
                  <th style="width: 100px; text-align: center;">Total Tasks</th>
                  <th style="width: 120px; text-align: center;">Actions</th>
                </tr>
              </thead>
              <tbody id="db-table-body">
                <!-- Dynamic rows -->
              </tbody>
            </table>
          </div>

        </div>
      </div>
    </main>
  </div>

  <!-- Edit Client Modal -->
  <div class="modal-overlay hidden" id="edit-client-modal">
    <div class="modal-card">
      <div class="modal-header">
        <h2>Edit Client Information</h2>
        <button class="close-btn" id="close-edit-modal-btn">&times;</button>
      </div>

      <form id="edit-client-form" class="complaint-form">
        <input type="hidden" id="edit-client-id" />

        <div class="form-group">
          <label for="edit-client-name">Client / Company Name</label>
          <input type="text" id="edit-client-name" required placeholder="PT Maju Jaya" class="form-control-textarea" style="height: auto; padding: 10px;" />
        </div>

        <div class="form-group">
          <label for="edit-client-code">Access Code</label>
          <input type="text" id="edit-client-code" required placeholder="MAJU123" class="form-control-textarea" style="height: auto; padding: 10px; font-family: monospace;" />
        </div>

        <div class="form-group">
          <label for="edit-client-project-name">Project Name</label>
          <input type="text" id="edit-client-project-name" placeholder="ERP System Phase 1" class="form-control-textarea" style="height: auto; padding: 10px;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <label for="edit-client-deadline-date">Deadline Date</label>
            <input type="date" id="edit-client-deadline-date" class="form-control-textarea" style="height: auto; padding: 8px;" />
          </div>
          <div class="form-group">
            <label for="edit-client-deadline-time">Deadline Time</label>
            <input type="time" id="edit-client-deadline-time" class="form-control-textarea" style="height: auto; padding: 8px;" />
          </div>
        </div>

        <div class="form-group">
          <label for="edit-client-contact">Contact Person / Number</label>
          <input type="text" id="edit-client-contact" placeholder="+62 812-3456-7890" class="form-control-textarea" style="height: auto; padding: 10px;" />
        </div>

        <div id="edit-client-error" class="error-banner hidden" style="color: #ef4444; font-size: 13px; font-weight: 500; margin-top: 4px;"></div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" id="cancel-edit-modal-btn">Cancel</button>
          <button type="submit" class="btn btn-primary" id="edit-submit-btn">
            <span id="edit-submit-text">Save Changes</span>
          </button>
        </div>
      </form>
    </div>
  </div>

</Layout>

<style>
  /* App layout container */
  .app-container {
    margin-left: 240px;
    min-height: 100vh;
    background-color: #f8fafc;
    box-sizing: border-box;
  }

  .main-content-panel {
    padding: 24px;
    box-sizing: border-box;
  }

  /* Excel Table Styling */
  .excel-table {
    width: 100%;
    border-collapse: collapse;
    font-family: 'Outfit', sans-serif;
    font-size: 13.5px;
    background-color: #ffffff;
  }

  .excel-table th {
    background-color: #f1f5f9;
    color: #475569;
    font-weight: 600;
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .excel-table td {
    padding: 12px 16px;
    border-bottom: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
    color: #334155;
  }

  .excel-table tr:hover {
    background-color: #f8fafc;
  }

  .excel-table th:last-child,
  .excel-table td:last-child {
    border-right: none;
  }

  /* Badge styling */
  .badge {
    background-color: #eff6ff;
    color: #2563eb;
    font-weight: 700;
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 6px;
    display: inline-block;
    border: 1px solid #bfdbfe;
  }

  /* Modal Styling */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(15, 23, 42, 0.3);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 16px;
    box-sizing: border-box;
  }

  .modal-card {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    width: 100%;
    max-width: 500px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .modal-header {
    padding: 16px 20px;
    border-bottom: 1px solid #cbd5e1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #f8fafc;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
  }

  .close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: #64748b;
    font-size: 20px;
    padding: 4px;
    border-radius: 4px;
    display: flex;
    align-items: center;
  }

  .close-btn:hover {
    background-color: #e2e8f0;
    color: #0f172a;
  }

  .complaint-form {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-sizing: border-box;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 12.5px;
    font-weight: 600;
    color: #334155;
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 10px;
  }

  /* Utility classes */
  .hidden {
    display: none !important;
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

<script>
  let clientsList: any[] = [];
  let searchQuery = '';

  const tableBody = document.getElementById('db-table-body');
  const tableContainer = document.getElementById('db-table-container');
  const loadingState = document.getElementById('db-loading-state');
  const emptyState = document.getElementById('db-empty-state');
  const searchInput = document.getElementById('database-client-search') as HTMLInputElement;

  // Edit Modal Selectors
  const editModal = document.getElementById('edit-client-modal');
  const editForm = document.getElementById('edit-client-form') as HTMLFormElement;
  const editClientId = document.getElementById('edit-client-id') as HTMLInputElement;
  const editClientName = document.getElementById('edit-client-name') as HTMLInputElement;
  const editClientCode = document.getElementById('edit-client-code') as HTMLInputElement;
  const editClientProjectName = document.getElementById('edit-client-project-name') as HTMLInputElement;
  const editClientDeadlineDate = document.getElementById('edit-client-deadline-date') as HTMLInputElement;
  const editClientDeadlineTime = document.getElementById('edit-client-deadline-time') as HTMLInputElement;
  const editClientContact = document.getElementById('edit-client-contact') as HTMLInputElement;
  const editClientError = document.getElementById('edit-client-error');

  const closeEditModalBtn = document.getElementById('close-edit-modal-btn');
  const cancelEditModalBtn = document.getElementById('cancel-edit-modal-btn');

  async function fetchClients() {
    if (loadingState) loadingState.classList.remove('hidden');
    if (tableContainer) tableContainer.classList.add('hidden');
    if (emptyState) emptyState.classList.add('hidden');

    try {
      const response = await fetch('/api/clients');
      const data = await response.json();

      if (loadingState) loadingState.classList.add('hidden');

      if (response.ok && data.success) {
        clientsList = data.clients;
        renderClients();
      } else {
        alert(`Failed to load clients: ${data.error}`);
      }
    } catch (e: any) {
      if (loadingState) loadingState.classList.add('hidden');
      alert(`Network error loading clients: ${e.message}`);
    }
  }

  function renderClients() {
    if (!tableBody || !tableContainer || !emptyState) return;

    // Filter by search query
    const query = searchQuery.toLowerCase();
    const filtered = clientsList.filter(c => 
      c.name.toLowerCase().includes(query) || 
      (c.project_name && c.project_name.toLowerCase().includes(query)) ||
      c.code.toLowerCase().includes(query)
    );

    if (filtered.length === 0) {
      tableBody.innerHTML = '';
      tableContainer.classList.add('hidden');
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    tableContainer.classList.remove('hidden');

    tableBody.innerHTML = filtered.map((client, index) => {
      const deadline = client.project_deadline_date 
        ? `${client.project_deadline_date} ${client.project_deadline_time || ''}` 
        : '<span style="color: #94a3b8; font-style: italic;">No deadline set</span>';

      return `
        <tr>
          <td style="font-weight: 700; text-align: center; background-color: #f8fafc;">${index + 1}</td>
          <td style="font-weight: 600; color: #0f172a;">${client.name}</td>
          <td><code style="font-family: monospace; font-size: 12.5px; background: #f1f5f9; padding: 2px 6px; border-radius: 4px;">${client.code}</code></td>
          <td>${client.contact || '<span style="color: #94a3b8; font-style: italic;">No contact</span>'}</td>
          <td>${client.project_name || '<span style="color: #94a3b8; font-style: italic;">No project specs</span>'}</td>
          <td>${deadline}</td>
          <td style="text-align: center;"><span class="badge">${client.task_count}</span></td>
          <td style="text-align: center;">
            <div style="display: flex; gap: 8px; justify-content: center;">
              <button class="btn btn-secondary btn-sm" onclick="openEditModal('${client.id}')" style="padding: 4px 8px; display: inline-flex; align-items: center; gap: 4px; cursor: pointer; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff;">
                <span>Edit</span>
              </button>
              <button class="btn btn-secondary btn-sm" onclick="deleteClient('${client.id}', '${client.name.replace(/'/g, "\\'")}')" style="padding: 4px 8px; color: #ef4444; border-color: #fca5a5; display: inline-flex; align-items: center; gap: 4px; cursor: pointer; border-radius: 4px; background: #fff;">
                <span>Delete</span>
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  // Open Edit Modal function mounted to window
  (window as any).openEditModal = (clientId: string) => {
    const client = clientsList.find(c => c.id === clientId);
    if (!client) return;

    if (editClientId) editClientId.value = client.id;
    if (editClientName) editClientName.value = client.name;
    if (editClientCode) editClientCode.value = client.code;
    if (editClientProjectName) editClientProjectName.value = client.project_name || '';
    if (editClientDeadlineDate) editClientDeadlineDate.value = client.project_deadline_date || '';
    if (editClientDeadlineTime) editClientDeadlineTime.value = client.project_deadline_time || '';
    if (editClientContact) editClientContact.value = client.contact || '';

    if (editClientError) {
      editClientError.classList.add('hidden');
      editClientError.textContent = '';
    }

    if (editModal) editModal.classList.remove('hidden');
  };

  // Close Modal functions
  function closeEditModal() {
    if (editModal) editModal.classList.add('hidden');
  }

  if (closeEditModalBtn) closeEditModalBtn.addEventListener('click', closeEditModal);
  if (cancelEditModalBtn) cancelEditModalBtn.addEventListener('click', closeEditModal);

  // Edit Client Submit Handler
  if (editForm) {
    editForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const id = editClientId.value;
      const name = editClientName.value.trim();
      const code = editClientCode.value.trim();
      const project_name = editClientProjectName.value.trim();
      const project_deadline_date = editClientDeadlineDate.value;
      const project_deadline_time = editClientDeadlineTime.value;
      const contact = editClientContact.value.trim();

      const submitBtn = document.getElementById('edit-submit-btn') as HTMLButtonElement;
      const submitText = document.getElementById('edit-submit-text');

      if (submitBtn) submitBtn.disabled = true;
      if (submitText) submitText.textContent = 'Saving...';
      if (editClientError) editClientError.classList.add('hidden');

      try {
        const response = await fetch('/api/clients', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id,
            name,
            code,
            project_name,
            project_deadline_date,
            project_deadline_time,
            contact
          })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          closeEditModal();
          fetchClients();
        } else {
          if (editClientError) {
            editClientError.textContent = data.error || 'Failed to update client details.';
            editClientError.classList.remove('hidden');
          }
        }
      } catch (err: any) {
        if (editClientError) {
          editClientError.textContent = `Network error: ${err.message}`;
          editClientError.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.textContent = 'Save Changes';
      }
    });
  }

  // Delete Client Handler
  (window as any).deleteClient = async (clientId: string, clientName: string) => {
    const confirmed = confirm(`Are you absolutely sure you want to delete the client "${clientName}"?\n\nWARNING: All of their task lists and videos will be deleted permanently!`);
    if (!confirmed) return;

    try {
      const response = await fetch('/api/clients', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: clientId })
      });

      const data = await response.json();

      if (response.ok && data.success) {
        alert('Client account deleted successfully!');
        fetchClients();
      } else {
        alert(`Failed to delete client: ${data.error}`);
      }
    } catch (err: any) {
      alert(`Network error deleting client: ${err.message}`);
    }
  };

  // Search filter
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value;
      renderClients();
    });
  }

  // Initial load
  fetchClients();
</script>
