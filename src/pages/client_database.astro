---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import { Loader2, Search } from '@lucide/astro';

const user = (Astro.locals as any).user;
if (!user) {
  return Astro.redirect('/login');
}
if (user.role !== 'admin' && user.role !== 'prof') {
  return Astro.redirect('/client');
}
---

<Layout>
  <head>
    <title>Client Database - MIJ ERP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <Sidebar role="admin" />

  <div class="app-container">
    <Header userName={user.name} userRole={user.role} title="Client Database" />

    <!-- Main Content -->
    <main class="main-content-panel" style="padding: 20px;">
      <div class="workspace-area">
        <div class="workspace-card" style="background-color: transparent; border: none; padding: 0; box-shadow: none;">
          
          <div style="display: flex; justify-content: flex-end; align-items: center; margin-bottom: 20px; gap: 16px; flex-wrap: wrap; width: 100%;">
            <!-- Search & Filter Area -->
            <div style="display: flex; gap: 12px; align-items: center; max-width: 520px; width: 100%;">
              <div class="search-box" style="position: relative; flex: 1;">
                <Search size={16} style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #64748b; pointer-events: none;" />
                <input 
                  type="text" 
                  id="database-client-search" 
                  placeholder="Search clients or projects..." 
                  style="width: 100%; padding: 8px 12px 8px 36px; border: 1px solid #cbd5e1; border-radius: 8px; font-family: inherit; font-size: 13.5px; box-sizing: border-box;"
                />
              </div>
              <select id="database-status-filter" style="padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-family: inherit; font-size: 13.5px; background: white; color: #334155; width: 160px; box-sizing: border-box; cursor: pointer; height: 38px;">
                <option value="all">All Status</option>
                <option value="rencana">Rencana</option>
                <option value="aktif">Aktif</option>
                <option value="dblokir">Diblokir</option>
                <option value="selesai">Selesai</option>
                <option value="gagal">Gagal</option>
              </select>
            </div>
          </div>
 
          <!-- Loading Row -->
          <div class="loading-state" id="db-loading-state" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; color: #64748b; gap: 8px;">
            <Loader2 size={28} class="animate-spin" />
            <p>Fetching database records...</p>
          </div>
 
          <!-- Empty State -->
          <div class="detail-empty-state hidden" id="db-empty-state" style="text-align: center; padding: 60px 20px; color: #64748b;">
            <h3>No Clients Registered</h3>
            <p>Use the "+ Add Client" button at the top header to register a client.</p>
          </div>
 
          <!-- Excel Table Container -->
          <div class="excel-table-container hidden" id="db-table-container" style="overflow-x: auto; margin-top: 10px; border: 1px solid #cbd5e1; border-radius: 0px; width: 100%;">
            <table class="excel-table" style="width: 100%; border-collapse: collapse;">
              <thead>
                <tr>
                  <th style="width: 50px; text-align: center;">No</th>
                  <th>Client / Company Name</th>
                  <th style="width: 130px;">Access Code</th>
                  <th>Contact</th>
                  <th style="width: 100px; text-align: center;">Project</th>
                  <th style="width: 180px;">Project Deadline</th>
                  <th style="width: 130px;">Status Project</th>
                  <th style="width: 100px; text-align: center;">Total Tasks</th>
                </tr>
              </thead>
              <tbody id="db-table-body">
                <!-- Dynamic rows -->
              </tbody>
            </table>
          </div>

        </div>
      </div>
    </main>
  </div>

  <div class="modal-overlay hidden" id="edit-client-modal">
    <div class="modal-card" style="max-width: 600px; width: 95%; border-radius: 0px; overflow: hidden; display: flex; flex-direction: column;">
      <div class="modal-header">
        <h2>Client Management Panel</h2>
        <button class="close-btn" id="close-edit-modal-btn">&times;</button>
      </div>

      <!-- Modal Tabs -->
      <div class="modal-tabs-navigation" style="display: flex; background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; width: 100%;">
        <button type="button" id="edit-tab-btn-account" class="modal-tab-nav active" style="flex: 1; border: none; padding: 12px; font-family: inherit; font-size: 13px; font-weight: 700; cursor: pointer; border-bottom: 2px solid var(--primary); color: var(--primary); background: transparent; outline: none;">
          Client Account Info
        </button>
        <button type="button" id="edit-tab-btn-projects" class="modal-tab-nav" style="flex: 1; border: none; padding: 12px; font-family: inherit; font-size: 13px; font-weight: 600; cursor: pointer; border-bottom: 2px solid transparent; color: var(--text-secondary); background: transparent; outline: none;">
          Projects List
        </button>
        <button type="button" id="edit-tab-btn-danger" class="modal-tab-nav" style="flex: 1; border: none; padding: 12px; font-family: inherit; font-size: 13px; font-weight: 600; cursor: pointer; border-bottom: 2px solid transparent; color: #ef4444; background: transparent; outline: none;">
          Danger Zone
        </button>
      </div>

      <div style="margin: 0; padding: 20px; display: flex; flex-direction: column; gap: 16px; overflow-y: auto;">
        <input type="hidden" id="edit-client-id" />

        <!-- Tab Panel 1: Account Info -->
        <div id="edit-panel-account" class="modal-tab-panel" style="display: flex; flex-direction: column; gap: 14px;">
          <form id="edit-client-form" style="margin: 0; display: flex; flex-direction: column; gap: 14px;">
            <div class="form-group">
              <label for="edit-client-name">Client / Company Name</label>
              <input type="text" id="edit-client-name" required placeholder="PT Maju Jaya" class="form-control-textarea" style="height: auto; padding: 10px;" />
            </div>

            <div class="form-group">
              <label for="edit-client-code">Access Code</label>
              <input type="text" id="edit-client-code" required placeholder="MAJU123" class="form-control-textarea" style="height: auto; padding: 10px; font-family: monospace;" />
            </div>

            <div class="form-group">
              <label for="edit-client-contact">Contact Person / Number</label>
              <input type="text" id="edit-client-contact" placeholder="+62 812-3456-7890" class="form-control-textarea" style="height: auto; padding: 10px;" />
            </div>

            <div class="form-group">
              <label for="edit-client-status">Project Status</label>
              <select id="edit-client-status" class="form-control-textarea" style="height: 38px; padding: 0 10px; cursor: pointer; width: 100%; border-radius: 6px; border: 1px solid #cbd5e1; background: white; color: #0f172a;">
                <option value="rencana">Rencana</option>
                <option value="aktif">Aktif</option>
                <option value="dblokir">Diblokir</option>
                <option value="selesai">Selesai</option>
                <option value="gagal">Gagal</option>
              </select>
            </div>

            <div id="edit-client-error" class="error-banner hidden" style="color: #ef4444; font-size: 13px; font-weight: 500; margin-top: 4px;"></div>

            <div class="modal-footer" style="margin-top: 10px; padding-top: 14px; border-top: 1px solid #cbd5e1; display: flex; justify-content: flex-end; gap: 8px;">
              <button type="button" class="btn btn-secondary" id="cancel-edit-modal-btn">Cancel</button>
              <button type="submit" class="btn btn-primary" id="edit-submit-btn">
                <span id="edit-submit-text">Save Changes</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Tab Panel 2: Projects List -->
        <div id="edit-panel-projects" class="modal-tab-panel hidden" style="display: flex; flex-direction: column; gap: 14px;">
          <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #cbd5e1; padding-bottom: 8px;">
            <h4 style="margin: 0; font-size: 14px; font-weight: 700; color: #0f172a;">Registered Projects</h4>
            <button type="button" class="btn btn-primary" id="modal-add-project-btn" style="font-size: 11px; padding: 6px 12px; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; border-radius: 4px;">
              <span>+ Add Project</span>
            </button>
          </div>

          <div id="modal-projects-list-container">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Tab Panel 3: Danger Zone -->
        <div id="edit-panel-danger" class="modal-tab-panel hidden" style="display: flex; flex-direction: column; gap: 14px;">
          <div style="background-color: #fee2e2; border: 1px solid #fca5a5; border-radius: 6px; padding: 14px; color: #991b1b; font-size: 13px; line-height: 1.5; text-align: left;">
            <strong>Warning:</strong> Deleting this client account will cascade delete the company profile, all projects listed under it, and all related tasks. This action cannot be undone.
          </div>
          
          <button type="button" id="edit-client-delete-btn" class="btn btn-danger" style="background-color: #dc2626; border-color: #dc2626; color: white; padding: 10px 16px; font-weight: 700; width: 100%; border-radius: 6px; cursor: pointer; text-align: center; margin-top: 10px;">
            Permanently Delete Account
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Project Modal -->
  <div class="modal-overlay hidden" id="add-project-modal" style="z-index: 1000; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; padding: 20px;">
    <div class="modal-card" style="max-width: 500px; width: 95%; border-radius: 0px; overflow: hidden; display: flex; flex-direction: column;">
      <div class="modal-header">
        <h2>Add New Project</h2>
        <button class="close-btn" id="close-add-project-modal-btn" type="button">&times;</button>
      </div>

      <form id="add-project-form" class="complaint-form" style="margin: 0; padding: 20px; display: flex; flex-direction: column; gap: 14px;">
        <input type="hidden" id="add-project-client-id" />

        <div class="form-group">
          <label for="add-project-name">Project Name</label>
          <input type="text" id="add-project-name" required placeholder="e.g. ERP System Phase 2" class="form-control-textarea" style="height: auto; padding: 10px;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <label for="add-project-deadline-date">Deadline Date</label>
            <input type="date" id="add-project-deadline-date" class="form-control-textarea" style="height: auto; padding: 8px;" />
          </div>
          <div class="form-group">
            <label for="add-project-deadline-time">Deadline Time</label>
            <input type="time" id="add-project-deadline-time" class="form-control-textarea" style="height: auto; padding: 8px;" />
          </div>
        </div>

        <div class="form-group">
          <label for="add-project-contact">Contact Person / Info</label>
          <input type="text" id="add-project-contact" placeholder="e.g. John Doe (+628...)" class="form-control-textarea" style="height: auto; padding: 10px;" />
        </div>

        <div id="add-project-error" class="error-banner hidden" style="color: #ef4444; font-size: 13px; font-weight: 500; margin-top: 4px;"></div>

        <div class="modal-footer" style="margin-top: 10px; padding-top: 14px; border-top: 1px solid #cbd5e1; display: flex; justify-content: flex-end; gap: 8px;">
          <button type="button" class="btn btn-secondary" id="cancel-add-project-modal-btn">Cancel</button>
          <button type="submit" class="btn btn-primary" id="add-project-submit-btn">
            <span id="add-project-submit-text">Add Project</span>
          </button>
        </div>
      </form>
    </div>
  </div>

</Layout>

<style>
  /* App layout container */
  .app-container {
    margin-left: 240px;
    min-height: 100vh;
    background-color: #f8fafc;
    box-sizing: border-box;
  }

  .main-content-panel {
    padding: 24px;
    box-sizing: border-box;
  }

  /* Excel Table Styling */
  .excel-table {
    width: 100%;
    border-collapse: collapse;
    font-family: 'Outfit', sans-serif;
    font-size: 13.5px;
    background-color: #ffffff;
  }

  .excel-table th {
    background-color: #f1f5f9;
    color: #475569;
    font-weight: 600;
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .excel-table td {
    padding: 12px 16px;
    border-bottom: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
    color: #334155;
  }

  .excel-table tr:hover {
    background-color: #f8fafc;
  }

  .excel-table th:last-child,
  .excel-table td:last-child {
    border-right: none;
  }

  /* Badge styling */
  .badge {
    background-color: #eff6ff;
    color: #2563eb;
    font-weight: 700;
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 6px;
    display: inline-block;
    border: 1px solid #bfdbfe;
  }

  .badge-rencana {
    background-color: #fef3c7;
    color: #d97706;
    font-weight: 700;
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid #fde68a;
    display: inline-block;
  }
  .badge-aktif {
    background-color: #dcfce7;
    color: #15803d;
    font-weight: 700;
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid #bbf7d0;
    display: inline-block;
  }
  .badge-dblokir {
    background-color: #fee2e2;
    color: #b91c1c;
    font-weight: 700;
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid #fecaca;
    display: inline-block;
  }
  .badge-selesai {
    background-color: #e0f2fe;
    color: #0369a1;
    font-weight: 700;
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid #bae6fd;
    display: inline-block;
  }
  .badge-gagal {
    background-color: #f3f4f6;
    color: #4b5563;
    font-weight: 700;
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid #e5e7eb;
    display: inline-block;
  }

  body.admin-theme .badge-rencana {
    background-color: rgba(217, 119, 6, 0.15) !important;
    color: #fbbf24 !important;
    border: 1px solid rgba(217, 119, 6, 0.4) !important;
  }
  body.admin-theme .badge-aktif {
    background-color: rgba(21, 128, 61, 0.15) !important;
    color: #4ade80 !important;
    border: 1px solid rgba(21, 128, 61, 0.4) !important;
  }
  body.admin-theme .badge-dblokir {
    background-color: rgba(185, 28, 28, 0.15) !important;
    color: #fca5a5 !important;
    border: 1px solid rgba(185, 28, 28, 0.4) !important;
  }
  body.admin-theme .badge-selesai {
    background-color: rgba(3, 105, 161, 0.15) !important;
    color: #38bdf8 !important;
    border: 1px solid rgba(3, 105, 161, 0.4) !important;
  }
  body.admin-theme .badge-gagal {
    background-color: rgba(75, 85, 99, 0.15) !important;
    color: #9ca3af !important;
    border: 1px solid rgba(75, 85, 99, 0.4) !important;
  }

  /* Modal Styling */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(15, 23, 42, 0.3);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 16px;
    box-sizing: border-box;
  }

  .modal-card {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    width: 100%;
    max-width: 500px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .modal-header {
    padding: 16px 20px;
    border-bottom: 1px solid #cbd5e1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #f8fafc;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
  }

  .close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: #64748b;
    font-size: 20px;
    padding: 4px;
    border-radius: 4px;
    display: flex;
    align-items: center;
  }

  .close-btn:hover {
    background-color: #e2e8f0;
    color: #0f172a;
  }

  .complaint-form {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-sizing: border-box;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 12.5px;
    font-weight: 600;
    color: #334155;
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 10px;
  }

  /* Utility classes */
  .hidden {
    display: none !important;
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

<script>
  let clientsList: any[] = [];
  let searchQuery = '';

  const tableBody = document.getElementById('db-table-body');
  const tableContainer = document.getElementById('db-table-container');
  const loadingState = document.getElementById('db-loading-state');
  const emptyState = document.getElementById('db-empty-state');
  const searchInput = document.getElementById('database-client-search') as HTMLInputElement;
  const statusFilterSelect = document.getElementById('database-status-filter') as HTMLSelectElement;
  let statusFilterQuery = 'all';

  // Edit Modal Selectors
  const editModal = document.getElementById('edit-client-modal');
  const editForm = document.getElementById('edit-client-form') as HTMLFormElement;
  const editClientId = document.getElementById('edit-client-id') as HTMLInputElement;
  const editClientName = document.getElementById('edit-client-name') as HTMLInputElement;
  const editClientCode = document.getElementById('edit-client-code') as HTMLInputElement;
  const editClientContact = document.getElementById('edit-client-contact') as HTMLInputElement;
  const editClientStatus = document.getElementById('edit-client-status') as HTMLSelectElement;
  const editClientError = document.getElementById('edit-client-error');

  const closeEditModalBtn = document.getElementById('close-edit-modal-btn');
  const cancelEditModalBtn = document.getElementById('cancel-edit-modal-btn');

  async function fetchClients() {
    if (loadingState) loadingState.classList.remove('hidden');
    if (tableContainer) tableContainer.classList.add('hidden');
    if (emptyState) emptyState.classList.add('hidden');

    try {
      const response = await fetch('/api/clients');
      const data = await response.json();

      if (loadingState) loadingState.classList.add('hidden');

      if (response.ok && data.success) {
        clientsList = data.clients;
        renderClients();
      } else {
        alert(`Failed to load clients: ${data.error}`);
      }
    } catch (e: any) {
      if (loadingState) loadingState.classList.add('hidden');
      alert(`Network error loading clients: ${e.message}`);
    }
  }

  function renderClients() {
    if (!tableBody || !tableContainer || !emptyState) return;

    // Filter by search query and project status
    const query = searchQuery.toLowerCase();
    const statusVal = statusFilterQuery.toLowerCase();
    const filtered = clientsList.filter(c => {
      const matchQuery = c.name.toLowerCase().includes(query) || 
        (c.project_name && c.project_name.toLowerCase().includes(query)) ||
        c.code.toLowerCase().includes(query);
      const matchStatus = statusVal === 'all' || (c.project_status && c.project_status.toLowerCase() === statusVal);
      return matchQuery && matchStatus;
    });

    if (filtered.length === 0) {
      tableBody.innerHTML = '';
      tableContainer.classList.add('hidden');
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    tableContainer.classList.remove('hidden');

    tableBody.innerHTML = filtered.map((client, index) => {
      const deadline = client.project_deadline_date 
        ? `${client.project_deadline_date} ${client.project_deadline_time || ''}` 
        : '<span style="color: #94a3b8; font-style: italic;">No deadline set</span>';

      const statusText = client.project_status || 'aktif';
      const displayStatus = statusText.toUpperCase();
      let badgeClass = 'badge-aktif';
      if (statusText === 'rencana') badgeClass = 'badge-rencana';
      else if (statusText === 'aktif') badgeClass = 'badge-aktif';
      else if (statusText === 'dblokir') badgeClass = 'badge-dblokir';
      else if (statusText === 'selesai') badgeClass = 'badge-selesai';
      else if (statusText === 'gagal') badgeClass = 'badge-gagal';

      return `
        <tr id="client-row-${client.id}" onclick="openEditModal('${client.id}')" style="cursor: pointer; transition: background-color 0.15s ease;">
          <td style="font-weight: 700; text-align: center; background-color: #f8fafc;">${index + 1}</td>
          <td style="font-weight: 600; color: #0f172a;">${client.name}</td>
          <td><code style="font-family: monospace; font-size: 12.5px; background: #f1f5f9; padding: 2px 6px; border-radius: 4px;">${client.code}</code></td>
          <td>${client.contact || '<span style="color: #94a3b8; font-style: italic;">No contact</span>'}</td>
          <td style="text-align: center;">
            <span class="badge" style="background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; font-weight: 600; padding: 2px 8px; border-radius: 4px; font-size: 11.5px; display: inline-block;" onclick="event.stopPropagation(); openEditModal('${client.id}', 'projects')">
              ${client.project_count || 0}
            </span>
          </td>
          <td>${deadline}</td>
          <td><span class="${badgeClass}">${displayStatus}</span></td>
          <td style="text-align: center;"><span class="badge">${client.task_count}</span></td>
        </tr>
      `;
    }).join('');
  }

  // Edit Client Modal Tabs switcher logic
  const editTabBtnAccount = document.getElementById('edit-tab-btn-account');
  const editTabBtnProjects = document.getElementById('edit-tab-btn-projects');
  const editTabBtnDanger = document.getElementById('edit-tab-btn-danger');
  const editPanelAccount = document.getElementById('edit-panel-account');
  const editPanelProjects = document.getElementById('edit-panel-projects');
  const editPanelDanger = document.getElementById('edit-panel-danger');

  function setEditModalTabActive(activeTab: 'account' | 'projects' | 'danger') {
    [editTabBtnAccount, editTabBtnProjects, editTabBtnDanger].forEach(btn => {
      if (btn) {
        btn.classList.remove('active');
        btn.style.borderBottom = '2px solid transparent';
        btn.style.color = 'var(--text-secondary)';
        btn.style.fontWeight = '600';
      }
    });

    [editPanelAccount, editPanelProjects, editPanelDanger].forEach(panel => {
      panel?.classList.add('hidden');
    });

    if (activeTab === 'account') {
      editTabBtnAccount?.classList.add('active');
      if (editTabBtnAccount) {
        editTabBtnAccount.style.borderBottom = '2px solid var(--primary)';
        editTabBtnAccount.style.color = 'var(--primary)';
        editTabBtnAccount.style.fontWeight = '700';
      }
      editPanelAccount?.classList.remove('hidden');
    } else if (activeTab === 'projects') {
      editTabBtnProjects?.classList.add('active');
      if (editTabBtnProjects) {
        editTabBtnProjects.style.borderBottom = '2px solid var(--primary)';
        editTabBtnProjects.style.color = 'var(--primary)';
        editTabBtnProjects.style.fontWeight = '700';
      }
      editPanelProjects?.classList.remove('hidden');
      const clientId = editClientId.value;
      if (clientId) {
        loadProjectsForClientInModal(clientId);
      }
    } else {
      editTabBtnDanger?.classList.add('active');
      if (editTabBtnDanger) {
        editTabBtnDanger.style.borderBottom = '2px solid #ef4444';
        editTabBtnDanger.style.color = '#ef4444';
        editTabBtnDanger.style.fontWeight = '700';
      }
      editPanelDanger?.classList.remove('hidden');
    }
  }

  if (editTabBtnAccount) editTabBtnAccount.addEventListener('click', () => setEditModalTabActive('account'));
  if (editTabBtnProjects) editTabBtnProjects.addEventListener('click', () => setEditModalTabActive('projects'));
  if (editTabBtnDanger) editTabBtnDanger.addEventListener('click', () => setEditModalTabActive('danger'));

  // Load projects inside modal list
  async function loadProjectsForClientInModal(clientId: string) {
    const container = document.getElementById('modal-projects-list-container');
    if (!container) return;

    container.innerHTML = '<div style="padding: 10px; text-align: center; color: #64748b;">Loading projects...</div>';

    try {
      const response = await fetch(`/api/projects?clientId=${clientId}`);
      const data = await response.json();

      if (response.ok && data.success) {
        const projects = data.projects;
        if (projects.length === 0) {
          container.innerHTML = '<div style="padding: 16px; text-align: center; color: #94a3b8; font-style: italic;">No projects registered. Click "+ Add Project" above to create one.</div>';
          return;
        }

        container.innerHTML = `
          <div class="excel-table-container" style="border: 1px solid #cbd5e1; border-radius: 4px; overflow: hidden; background: white; max-height: 250px; overflow-y: auto;">
            <table class="excel-table" style="width: 100%; border-collapse: collapse;">
              <thead>
                <tr style="background: #f8fafc; border-bottom: 1px solid #cbd5e1;">
                  <th style="padding: 8px; font-weight: 600; font-size: 12px; text-align: left;">Project Name</th>
                  <th style="padding: 8px; font-weight: 600; font-size: 12px; text-align: left; width: 140px;">Deadline</th>
                  <th style="padding: 8px; font-weight: 600; font-size: 12px; text-align: center; width: 100px;">Actions</th>
                </tr>
              </thead>
              <tbody>
                ${projects.map((proj: any) => {
                  const deadlineStr = proj.deadline_date 
                    ? `${proj.deadline_date} ${proj.deadline_time || ''}` 
                    : '<span style="color: #94a3b8; font-style: italic;">No deadline</span>';
                  return `
                    <tr style="border-bottom: 1px solid #e2e8f0;">
                      <td style="padding: 8px; font-size: 12.5px; font-weight: 600; color: #0f172a; white-space: normal;">${proj.name}</td>
                      <td style="padding: 8px; font-size: 11.5px; color: #475569; white-space: normal;">${deadlineStr}</td>
                      <td style="padding: 8px; text-align: center;">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="event.stopPropagation(); submitDeleteProject('${clientId}', '${proj.id}', '${proj.name.replace(/'/g, "\\'")}')" style="padding: 2px 6px; font-size: 10.5px; color: #ef4444; border-color: #fca5a5; cursor: pointer; background: #fff;">
                          Delete
                        </button>
                      </td>
                    </tr>
                  `;
                }).join('')}
              </tbody>
            </table>
          </div>
        `;
      } else {
        container.innerHTML = `<div style="padding: 10px; text-align: center; color: #ef4444;">Failed to load: ${data.error}</div>`;
      }
    } catch (err: any) {
      container.innerHTML = `<div style="padding: 10px; text-align: center; color: #ef4444;">Network error: ${err.message}</div>`;
    }
  }

  // Open Edit Modal function mounted to window
  (window as any).openEditModal = (clientId: string, defaultTab?: 'account' | 'projects' | 'danger') => {
    const client = clientsList.find(c => c.id === clientId);
    if (!client) return;

    if (editClientId) editClientId.value = client.id;
    if (editClientName) editClientName.value = client.name;
    if (editClientCode) editClientCode.value = client.code;
    if (editClientContact) editClientContact.value = client.contact || '';
    if (editClientStatus) editClientStatus.value = client.project_status || 'aktif';

    if (editClientError) {
      editClientError.classList.add('hidden');
      editClientError.textContent = '';
    }

    // Default tab
    setEditModalTabActive(defaultTab || 'account');

    if (editModal) editModal.classList.remove('hidden');
  };

  // Close Modal functions
  function closeEditModal() {
    if (editModal) editModal.classList.add('hidden');
  }

  if (closeEditModalBtn) closeEditModalBtn.addEventListener('click', closeEditModal);
  if (cancelEditModalBtn) cancelEditModalBtn.addEventListener('click', closeEditModal);

  // Edit Client Submit Handler
  if (editForm) {
    editForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const id = editClientId.value;
      const name = editClientName.value.trim();
      const code = editClientCode.value.trim();
      const contact = editClientContact.value.trim();
      const project_status = editClientStatus.value;

      const submitBtn = document.getElementById('edit-submit-btn') as HTMLButtonElement;
      const submitText = document.getElementById('edit-submit-text');

      if (submitBtn) submitBtn.disabled = true;
      if (submitText) submitText.textContent = 'Saving...';
      if (editClientError) editClientError.classList.add('hidden');

      try {
        const response = await fetch('/api/clients', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id,
            name,
            code,
            contact,
            project_status
          })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          closeEditModal();
          fetchClients();
        } else {
          if (editClientError) {
            editClientError.textContent = data.error || 'Failed to update client details.';
            editClientError.classList.remove('hidden');
          }
        }
      } catch (err: any) {
        if (editClientError) {
          editClientError.textContent = `Network error: ${err.message}`;
          editClientError.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.textContent = 'Save Changes';
      }
    });
  }

  // Bind modal inner buttons
  const modalAddProjectBtn = document.getElementById('modal-add-project-btn');
  if (modalAddProjectBtn) {
    modalAddProjectBtn.addEventListener('click', () => {
      const clientId = editClientId.value;
      if (clientId) {
        (window as any).showAddProjectForm(clientId);
      }
    });
  }

  const editClientDeleteBtn = document.getElementById('edit-client-delete-btn');
  if (editClientDeleteBtn) {
    editClientDeleteBtn.addEventListener('click', () => {
      const id = editClientId.value;
      const name = editClientName.value;
      if (id && name) {
        (window as any).deleteClient(id, name);
      }
    });
  }

  // Delete Client Handler
  (window as any).deleteClient = async (clientId: string, clientName: string) => {
    const confirmed = confirm(`Are you absolutely sure you want to delete the client "${clientName}"?\n\nWARNING: All of their task lists and videos will be deleted permanently!`);
    if (!confirmed) return;

    try {
      const response = await fetch('/api/clients', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: clientId })
      });

      const data = await response.json();

      if (response.ok && data.success) {
        alert('Client account deleted successfully!');
        closeEditModal();
        fetchClients();
      } else {
        alert(`Failed to delete client: ${data.error}`);
      }
    } catch (err: any) {
      alert(`Network error deleting client: ${err.message}`);
    }
  };

  // Search filter
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value;
      renderClients();
    });
  }

  // Status dropdown filter
  if (statusFilterSelect) {
    statusFilterSelect.addEventListener('change', () => {
      statusFilterQuery = statusFilterSelect.value;
      renderClients();
    });
  }



  // Add Project Modal Controls
  const addProjectModal = document.getElementById('add-project-modal');
  const addProjectForm = document.getElementById('add-project-form') as HTMLFormElement;
  const addProjectClientId = document.getElementById('add-project-client-id') as HTMLInputElement;
  const addProjectName = document.getElementById('add-project-name') as HTMLInputElement;
  const addProjectDeadlineDate = document.getElementById('add-project-deadline-date') as HTMLInputElement;
  const addProjectDeadlineTime = document.getElementById('add-project-deadline-time') as HTMLInputElement;
  const addProjectContact = document.getElementById('add-project-contact') as HTMLInputElement;
  const addProjectError = document.getElementById('add-project-error');
  const addProjectSubmitBtn = document.getElementById('add-project-submit-btn') as HTMLButtonElement;
  const addProjectSubmitText = document.getElementById('add-project-submit-text');

  (window as any).showAddProjectForm = (clientId: string) => {
    if (addProjectClientId) addProjectClientId.value = clientId;
    if (addProjectForm) addProjectForm.reset();
    if (addProjectError) {
      addProjectError.classList.add('hidden');
      addProjectError.textContent = '';
    }
    if (addProjectModal) addProjectModal.classList.remove('hidden');
  };

  function closeAddProjectModal() {
    if (addProjectModal) addProjectModal.classList.add('hidden');
  }

  const closeAddProjectModalBtn = document.getElementById('close-add-project-modal-btn');
  const cancelAddProjectModalBtn = document.getElementById('cancel-add-project-modal-btn');
  if (closeAddProjectModalBtn) closeAddProjectModalBtn.addEventListener('click', closeAddProjectModal);
  if (cancelAddProjectModalBtn) cancelAddProjectModalBtn.addEventListener('click', closeAddProjectModal);

  // Add Project Submit
  if (addProjectForm) {
    addProjectForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const clientId = addProjectClientId.value;
      const name = addProjectName.value.trim();
      const deadline_date = addProjectDeadlineDate.value;
      const deadline_time = addProjectDeadlineTime.value;
      const contact = addProjectContact.value.trim();

      if (!clientId || !name) return;

      if (addProjectSubmitBtn) addProjectSubmitBtn.disabled = true;
      if (addProjectSubmitText) addProjectSubmitText.textContent = 'Saving...';
      if (addProjectError) addProjectError.classList.add('hidden');

      try {
        const response = await fetch('/api/projects', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            clientId,
            name,
            deadline_date,
            deadline_time,
            contact
          })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          closeAddProjectModal();
          // Reload project list inside modal
          loadProjectsForClientInModal(clientId);
          // Re-fetch client list to update badge count
          await fetchClients();
        } else {
          if (addProjectError) {
            addProjectError.textContent = data.error || 'Failed to create project.';
            addProjectError.classList.remove('hidden');
          }
        }
      } catch (err: any) {
        if (addProjectError) {
          addProjectError.textContent = `Network error: ${err.message}`;
          addProjectError.classList.remove('hidden');
        }
      } finally {
        if (addProjectSubmitBtn) addProjectSubmitBtn.disabled = false;
        if (addProjectSubmitText) addProjectSubmitText.textContent = 'Add Project';
      }
    });
  }

  // Open Edit Project Inline form in modal
  (window as any).openEditProjectInlineInModal = (clientId: string, projId: string, name: string, date: string, time: string, contact: string) => {
    const row = document.getElementById(`modal-project-row-${projId}`);
    if (!row) return;

    row.innerHTML = `
      <td colspan="3" style="padding: 8px; background: #f8fafc;">
        <form onsubmit="(window as any).submitEditProjectInModal(event, '${clientId}', '${projId}')" style="display: flex; flex-direction: column; gap: 8px; width: 100%; margin: 0; padding: 4px;">
          <div class="form-group" style="gap: 4px; margin: 0;">
            <label style="font-size: 11px; font-weight: 600; color: #475569;">Project Name</label>
            <input type="text" id="edit-modal-proj-name-${projId}" required value="${name}" class="form-control-textarea" style="height: 32px; padding: 4px 8px; font-size: 12px; box-sizing: border-box;" />
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <div class="form-group" style="gap: 4px; margin: 0;">
              <label style="font-size: 11px; font-weight: 600; color: #475569;">Deadline Date</label>
              <input type="date" id="edit-modal-proj-date-${projId}" value="${date}" class="form-control-textarea" style="height: 32px; padding: 4px 8px; font-size: 12px; box-sizing: border-box;" />
            </div>
            <div class="form-group" style="gap: 4px; margin: 0;">
              <label style="font-size: 11px; font-weight: 600; color: #475569;">Deadline Time</label>
              <input type="time" id="edit-modal-proj-time-${projId}" value="${time}" class="form-control-textarea" style="height: 32px; padding: 4px 8px; font-size: 12px; box-sizing: border-box;" />
            </div>
          </div>
          <div class="form-group" style="gap: 4px; margin: 0;">
            <label style="font-size: 11px; font-weight: 600; color: #475569;">Contact</label>
            <input type="text" id="edit-modal-proj-contact-${projId}" value="${contact}" class="form-control-textarea" style="height: 32px; padding: 4px 8px; font-size: 12px; box-sizing: border-box;" />
          </div>
          <div style="display: flex; gap: 6px; justify-content: flex-end; margin-top: 4px;">
            <button type="submit" class="btn btn-primary btn-sm" style="padding: 4px 10px; font-size: 11px;">Save</button>
            <button type="button" class="btn btn-secondary btn-sm" onclick="loadProjectsForClientInModal('${clientId}')" style="padding: 4px 10px; font-size: 11px;">Cancel</button>
          </div>
        </form>
      </td>
    `;
  };

  // Edit Project Submit in modal
  (window as any).submitEditProjectInModal = async (event: Event, clientId: string, projId: string) => {
    event.preventDefault();

    const nameInput = document.getElementById(`edit-modal-proj-name-${projId}`) as HTMLInputElement;
    const dateInput = document.getElementById(`edit-modal-proj-date-${projId}`) as HTMLInputElement;
    const timeInput = document.getElementById(`edit-modal-proj-time-${projId}`) as HTMLInputElement;
    const contactInput = document.getElementById(`edit-modal-proj-contact-${projId}`) as HTMLInputElement;

    const name = nameInput.value.trim();
    const deadline_date = dateInput.value;
    const deadline_time = timeInput.value;
    const contact = contactInput.value.trim();

    try {
      const response = await fetch('/api/projects', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: projId,
          name,
          deadline_date,
          deadline_time,
          contact
        })
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Reload modal list
        loadProjectsForClientInModal(clientId);
        // Refresh client list
        fetchClients();
      } else {
        alert(`Failed to save project: ${data.error}`);
      }
    } catch (err: any) {
      alert(`Network error saving project: ${err.message}`);
    }
  };

  // Delete Project Submit
  (window as any).submitDeleteProject = async (clientId: string, projId: string, name: string) => {
    const confirmed = confirm(`Are you absolutely sure you want to delete the project "${name}"?\n\nWARNING: All of its task lists will be permanently deleted!`);
    if (!confirmed) return;

    try {
      const response = await fetch('/api/projects', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: projId })
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Reload list inside modal
        loadProjectsForClientInModal(clientId);
        // Re-fetch client list to update badge count
        await fetchClients();
      } else {
        alert(`Failed to delete project: ${data.error}`);
      }
    } catch (err: any) {
      alert(`Network error deleting project: ${err.message}`);
    }
  };

  // Initial load
  fetchClients();
</script>
