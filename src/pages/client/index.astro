---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Header from '../../components/Header.astro';

const user = (Astro.locals as any).user;
if (!user) {
  return Astro.redirect('/login');
}
---

<Layout>
  <head>
    <title>Client Portal - MIJ ERP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <Sidebar role="client" />

  <div class="app-container">
    <Header userName={user.name} userRole={user.role} title="Project Overview" />

    <!-- Main Content -->
    <main class="main-content">
      
      <!-- Top Action Bar -->
      <div class="workspace-header-bar" style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 20px;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <label for="client-project-select" style="font-weight: 700; font-size: 15px; color: var(--text-primary);">Active Project:</label>
          <select id="client-project-select" style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px 16px; font-size: 14px; font-weight: 600; font-family: inherit; background-color: white; cursor: pointer; outline: none; box-shadow: 0 1px 2px rgba(0,0,0,0.05); min-width: 200px;">
            <option value="">Loading projects...</option>
          </select>
        </div>
      </div>

      <!-- Stats Cards Grid -->
      <div class="stats-overview-grid">
        <div class="stat-card">
          <div class="stat-title">Total Requests</div>
          <div id="dashboard-stat-total" class="stat-value">0</div>
        </div>
        <div class="stat-card in-progress">
          <div class="stat-title">In Progress</div>
          <div id="dashboard-stat-progress" class="stat-value" style="color: #b45309;">0</div>
        </div>
        <div class="stat-card review">
          <div class="stat-title">Under Review</div>
          <div id="dashboard-stat-review" class="stat-value" style="color: #1e40af;">0</div>
        </div>
        <div class="stat-card completed">
          <div class="stat-title">Completed</div>
          <div id="dashboard-stat-completed" class="stat-value" style="color: #15803d;">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-title">Active Requests</div>
          <div id="dashboard-stat-active" class="stat-value" style="color: #ea580c;">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-title">Project Info</div>
          <div id="dashboard-stat-updates" class="stat-value" style="color: #2563eb;">0</div>
        </div>
      </div>

      <!-- Charts Container -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin-top: 16px;">
        <!-- Left Chart Container: Progress Gauge -->
        <div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 0px; padding: 20px; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 220px; box-shadow: none;">
          <h4 style="margin: 0 0 14px 0; font-size: 13px; font-weight: 700; color: #334155; width: 100%; text-align: left; text-transform: uppercase; letter-spacing: 0.5px;">Project Development Progress</h4>
          <div style="position: relative; width: 140px; height: 140px; display: flex; align-items: center; justify-content: center;">
            <svg width="130" height="130" viewBox="0 0 140 140">
              <circle cx="70" cy="70" r="55" fill="none" stroke="#f1f5f9" stroke-width="10" />
              <circle id="progress-gauge-circle" cx="70" cy="70" r="55" fill="none" stroke="url(#progress-grad)" stroke-width="10" stroke-dasharray="345" stroke-dashoffset="345" stroke-linecap="butt" transform="rotate(-90 70 70)" style="transition: stroke-dashoffset 0.8s ease-in-out;" />
              <defs>
                <linearGradient id="progress-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#2563eb" />
                  <stop offset="100%" stop-color="#16a34a" />
                </linearGradient>
              </defs>
            </svg>
            <div style="position: absolute; text-align: center; display: flex; flex-direction: column;">
              <span id="progress-gauge-percentage" style="font-size: 24px; font-weight: 800; color: #0f172a;">0%</span>
              <span style="font-size: 10px; color: #64748b; font-weight: 600; text-transform: uppercase; margin-top: 1px;">Resolved</span>
            </div>
          </div>
        </div>

        <!-- Right Chart Container: SVG Bar Chart -->
        <div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 0px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; min-height: 220px; box-shadow: none;">
          <h4 style="margin: 0 0 14px 0; font-size: 13px; font-weight: 700; color: #334155; text-transform: uppercase; letter-spacing: 0.5px;">Task Status Distribution</h4>
          <div style="display: flex; flex-direction: column; gap: 12px; flex-grow: 1; justify-content: center;">
            <div style="display: flex; flex-direction: column; gap: 4px;">
              <div style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; color: #475569;">
                <span>In Progress</span>
                <span id="bar-val-progress">0</span>
              </div>
              <div style="height: 8px; background-color: #f1f5f9; border-radius: 0px; overflow: hidden; width: 100%; border: 1px solid #e2e8f0;">
                <div id="bar-fill-progress" style="width: 0%; height: 100%; background-color: #b45309; border-radius: 0px; transition: width 0.8s ease-in-out;"></div>
              </div>
            </div>
            <div style="display: flex; flex-direction: column; gap: 4px;">
              <div style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; color: #475569;">
                <span>Under Review</span>
                <span id="bar-val-review">0</span>
              </div>
              <div style="height: 8px; background-color: #f1f5f9; border-radius: 0px; overflow: hidden; width: 100%; border: 1px solid #e2e8f0;">
                <div id="bar-fill-review" style="width: 0%; height: 100%; background-color: #1e40af; border-radius: 0px; transition: width 0.8s ease-in-out;"></div>
              </div>
            </div>
            <div style="display: flex; flex-direction: column; gap: 4px;">
              <div style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; color: #475569;">
                <span>Completed</span>
                <span id="bar-val-completed">0</span>
              </div>
              <div style="height: 8px; background-color: #f1f5f9; border-radius: 0px; overflow: hidden; width: 100%; border: 1px solid #e2e8f0;">
                <div id="bar-fill-completed" style="width: 0%; height: 100%; background-color: #15803d; border-radius: 0px; transition: width 0.8s ease-in-out;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer style="margin-top: auto; padding: 16px 24px; border-top: 1px solid #cbd5e1; text-align: center; font-size: 12px; color: #64748b; background-color: #ffffff; width: 100%; box-sizing: border-box;">
      &copy; {new Date().getFullYear()} MIJ Digital. All rights reserved.
    </footer>
  </div>
</Layout>

<style>
  :root {
    --bg-light: #f8fafc;
    --bg-card: #ffffff;
    --border-color: #cbd5e1;
    --text-primary: #0f172a;
    --text-secondary: #475569;
    --primary: #2563eb;
    --primary-hover: #1d4ed8;
    --primary-light: rgba(37, 99, 235, 0.05);

    --font-heading: system-ui, -apple-system, sans-serif;
    --font-body: system-ui, -apple-system, sans-serif;
  }

  body {
    background-color: var(--bg-light);
    color: var(--text-primary);
    font-family: var(--font-body);
    margin: 0;
  }

  .app-container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding-left: 240px;
    transition: padding-left 0.2s ease-in-out;
  }

  /* When collapsed */
  body.sidebar-collapsed .app-container {
    padding-left: 0;
  }

  body.sidebar-collapsed :global(.app-sidebar) {
    transform: translateX(-240px);
  }

  .main-content {
    flex-grow: 1;
    padding: 24px;
    background-color: #ffffff;
    min-height: calc(100vh - 64px);
    box-sizing: border-box;
    min-width: 0;
    overflow: hidden;
  }

  .workspace-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #cbd5e1;
    padding-bottom: 16px;
    margin-bottom: 20px;
  }

  .workspace-header-bar h2 {
    margin: 0;
    font-size: 15.5px;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* Stats Overview Grid */
  .stats-overview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0px;
    margin-bottom: 20px;
    width: 100%;
    border: 1px solid #cbd5e1;
  }

  .stat-card {
    background-color: #ffffff;
    border-right: 1px solid #cbd5e1;
    border-bottom: 1px solid #cbd5e1;
    border-radius: 0px;
    padding: 14px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
    transition: background-color 0.15s ease;
    box-shadow: none !important;
  }

  .stat-card:last-child {
    border-right: none;
  }

  .stat-card:hover {
    background-color: #f8fafc;
  }

  .stat-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-secondary);
    letter-spacing: 0.5px;
  }

  .stat-value {
    font-size: 24px;
    font-weight: 800;
    color: var(--text-primary);
  }

  .stat-card.in-progress {
    border-left: 3px solid #b45309;
  }

  .stat-card.review {
    border-left: 3px solid #1e40af;
  }

  .stat-card.completed {
    border-left: 3px solid #15803d;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 768px) {
    .main-content {
      padding: 16px 12px !important;
    }
    .workspace-header-bar {
      flex-direction: column;
      align-items: flex-start !important;
      gap: 12px;
      margin-bottom: 16px !important;
    }
    #client-project-select {
      width: 100% !important;
    }
    .stats-overview-grid {
      grid-template-columns: 1fr !important;
      gap: 10px !important;
    }
  }
</style>

<script>
  let allTasks: any[] = [];
  let allUpdates: any[] = [];
  let currentProjectId = '';
  let clientProjectsList: any[] = [];

  const projectSelect = document.getElementById('client-project-select') as HTMLSelectElement;

  function onProjectChange() {
    loadTasks();
  }

  async function loadTasks() {
    try {
      const response = await fetch(currentProjectId ? `/api/tasks?projectId=${currentProjectId}` : '/api/tasks');
      const data = await response.json();
      if (response.ok && data.success) {
        allTasks = data.tasks || [];
      }
    } catch(e) {
      console.error(e);
    }

    try {
      const response = await fetch(currentProjectId ? `/api/project-updates?projectId=${currentProjectId}` : '/api/project-updates');
      const data = await response.json();
      if (response.ok && data.success) {
        allUpdates = data.updates || [];
      }
    } catch(e) {
      console.error(e);
    }

    updateDashboardStats();
  }

  function updateDashboardStats() {
    const total = allTasks.length;
    const progress = allTasks.filter(t => t.status === 'proses').length;
    const review = allTasks.filter(t => t.status === 'review').length;
    const completed = allTasks.filter(t => t.status === 'selesai').length;
    const active = allTasks.filter(t => t.status !== 'selesai').length;
    const updates = allUpdates.length;

    // Update numbers
    const elTotal = document.getElementById('dashboard-stat-total');
    const elProgress = document.getElementById('dashboard-stat-progress');
    const elReview = document.getElementById('dashboard-stat-review');
    const elCompleted = document.getElementById('dashboard-stat-completed');
    const elActive = document.getElementById('dashboard-stat-active');
    const elUpdates = document.getElementById('dashboard-stat-updates');

    if (elTotal) elTotal.textContent = String(total);
    if (elProgress) elProgress.textContent = String(progress);
    if (elReview) elReview.textContent = String(review);
    if (elCompleted) elCompleted.textContent = String(completed);
    if (elActive) elActive.textContent = String(active);
    if (elUpdates) elUpdates.textContent = String(updates);

    // Update progress charts
    const rate = total > 0 ? Math.round((completed / total) * 100) : 0;
    const elPerc = document.getElementById('progress-gauge-percentage');
    const elCircle = document.getElementById('progress-gauge-circle');

    if (elPerc) elPerc.textContent = `${rate}%`;
    if (elCircle) {
      // 345 is stroke-dasharray (circumference of radius 55: 2 * PI * 55 = 345.5)
      const offset = 345 - (rate / 100) * 345;
      elCircle.setAttribute('stroke-dashoffset', String(offset));
    }

    // Update bars
    const elValProgress = document.getElementById('bar-val-progress');
    const elValReview = document.getElementById('bar-val-review');
    const elValCompleted = document.getElementById('bar-val-completed');

    const elBarProgress = document.getElementById('bar-fill-progress');
    const elBarReview = document.getElementById('bar-fill-review');
    const elBarCompleted = document.getElementById('bar-fill-completed');

    if (elValProgress) elValProgress.textContent = String(progress);
    if (elValReview) elValReview.textContent = String(review);
    if (elValCompleted) elValCompleted.textContent = String(completed);

    const max = total > 0 ? total : 1;
    if (elBarProgress) elBarProgress.style.width = `${(progress / max) * 100}%`;
    if (elBarReview) elBarReview.style.width = `${(review / max) * 100}%`;
    if (elBarCompleted) elBarCompleted.style.width = `${(completed / max) * 100}%`;
  }

  async function initializeProjects() {
    try {
      const response = await fetch('/api/profile');
      const data = await response.json();
      if (response.ok && data.success) {
        clientProjectsList = data.projects || [];
        
        if (projectSelect) {
          projectSelect.innerHTML = '';
          if (clientProjectsList.length === 0) {
            projectSelect.innerHTML = '<option value="">-- No Projects Found --</option>';
            return;
          }
          
          clientProjectsList.forEach((proj) => {
            const option = document.createElement('option');
            option.value = proj.id;
            option.textContent = proj.name;
            projectSelect.appendChild(option);
          });
          
          // Persist selected project using localStorage
          const savedProjectId = localStorage.getItem('activeProjectId');
          const hasSavedProject = savedProjectId && clientProjectsList.some(p => p.id === savedProjectId);
          
          if (hasSavedProject) {
            currentProjectId = savedProjectId;
          } else {
            currentProjectId = clientProjectsList[0].id;
            localStorage.setItem('activeProjectId', currentProjectId);
          }
          projectSelect.value = currentProjectId;
          
          // Add change listener
          projectSelect.addEventListener('change', () => {
            currentProjectId = projectSelect.value;
            localStorage.setItem('activeProjectId', currentProjectId);
            onProjectChange();
          });
        }
      }
    } catch (e) {
      console.error('Error loading client projects:', e);
    }
  }

  // Initial Load
  initializeProjects().then(() => {
    onProjectChange();
  });
</script>
