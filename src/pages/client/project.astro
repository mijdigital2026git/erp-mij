</style>

<script>
  let allTasks: any[] = [];
  let clientUpdates: any[] = [];
  let currentCategoryFilter = 'all';
  let currentStatusFilter = 'all';
  let currentProjectId = '';
  let clientProjectsList: any[] = [];

  // Persistent project select
  const projectSelect = document.getElementById('client-project-select') as HTMLSelectElement;

  function onProjectChange() {
    loadTasks();
    loadProjectUpdates();
  }

  async function loadProjectUpdates() {
    try {
      const response = await fetch(currentProjectId ? `/api/project-updates?projectId=${currentProjectId}` : '/api/project-updates');
      const data = await response.json();
      if (response.ok && data.success) {
        clientUpdates = data.updates || [];
      }
    } catch(e) {
      console.error(e);
    }
  }

  // Google Drive helper to transform watch links into high-performance thumbnails or video direct links
  function getDirectDriveUrl(url: string, type: 'image' | 'video' | 'media') {
    if (!url) return '';
    const cleanUrl = url.trim();
    const driveMatch = cleanUrl.match(/\/file\/d\/([^\/]+)/) || cleanUrl.match(/id=([^&]+)/);
    if (driveMatch) {
      const fileId = driveMatch[1];
      if (type === 'image') {
        return `https://drive.google.com/thumbnail?id=${fileId}&sz=w1000`;
      }
      return `https://drive.google.com/uc?export=download&id=${fileId}`;
    }
    return cleanUrl;
  }

  // Helper to generate media preview HTML inside the modal
  function getMediaPreviewHTML(url: string, type?: string, name?: string) {
    if (!url) return '';
    const cleanUrl = url.trim();
    const fileType = type ? type.toLowerCase() : '';
    const fileName = name ? name.toLowerCase() : '';
    
    // Extract Google Drive File ID if present
    const driveMatch = cleanUrl.match(/\/file\/d\/([^\/]+)/) || cleanUrl.match(/id=([^&]+)/);
    const fileId = driveMatch ? driveMatch[1] : null;

    const isImage = fileType.includes('image') || 
                    fileName.includes('.png') || fileName.includes('.jpg') || fileName.includes('.jpeg') || 
                    fileName.includes('.gif') || fileName.includes('.webp') || fileName.includes('.jfif') || 
                    fileName.includes('.heic') || fileName.includes('.heif') || fileName.includes('.bmp') ||
                    cleanUrl.includes('.png') || cleanUrl.includes('.jpg') || cleanUrl.includes('.jpeg') || 
                    cleanUrl.includes('.gif') || cleanUrl.includes('.webp') || cleanUrl.includes('.jfif');

    const isAudio = fileType.includes('audio') || 
                    fileName.includes('.mp3') || fileName.includes('.wav') || fileName.includes('.m4a') || 
                    fileName.includes('.webm') || fileName.includes('.ogg') ||
                    cleanUrl.includes('.webm') || cleanUrl.includes('.mp3') || cleanUrl.includes('.wav') || 
                    cleanUrl.includes('.m4a') || cleanUrl.includes('.ogg');

    if (isImage) {
      const imgSrc = fileId ? `https://drive.google.com/thumbnail?id=${fileId}&sz=w1000` : cleanUrl;
      return `<div style="margin-bottom: 10px;">
        <div style="font-size: 11.5px; font-weight: 600; color: #64748b; margin-bottom: 4px;">File Attachment:</div>
        <img src="${imgSrc}" style="width: 100%; max-height: 200px; object-fit: contain; border-radius: 8px; border: 1px solid #cbd5e1; cursor: pointer;" onclick="showPhotoPreview('${cleanUrl}', 'File Attachment')" />
      </div>`;
    }

    if (fileId) {
      // Use iframe preview player for Google Drive files (universal player)
      return `<div style="margin-bottom: 10px;">
        <div style="font-size: 11.5px; font-weight: 600; color: #64748b; margin-bottom: 4px;">File Attachment:</div>
        <iframe src="https://drive.google.com/file/d/${fileId}/preview" width="100%" height="240" style="border: none; border-radius: 8px; background: #000;" allow="autoplay"></iframe>
      </div>`;
    } else {
      // Fallback for non-drive URLs
      if (isAudio) {
        return `<div style="margin-bottom: 10px;">
          <div style="font-size: 11.5px; font-weight: 600; color: #64748b; margin-bottom: 4px;">File Attachment:</div>
          <audio src="${cleanUrl}" controls style="width: 100%;"></audio>
        </div>`;
      } else {
        return `<div style="margin-bottom: 10px;">
          <div style="font-size: 11.5px; font-weight: 600; color: #64748b; margin-bottom: 4px;">File Attachment:</div>
          <video src="${cleanUrl}" controls style="width: 100%; max-height: 200px; border-radius: 8px; background: #000;"></video>
        </div>`;
      }
    }
  }

  // Modal tabs switching setup
  const tabBtnDev = document.getElementById('modal-tab-btn-dev');
  const tabBtnClient = document.getElementById('modal-tab-btn-client');
  const modalColClient = document.getElementById('modal-col-client');
  const modalColDev = document.getElementById('modal-col-developer');

  function setModalTabActive(activeTab: 'dev' | 'client') {
    if (activeTab === 'dev') {
      tabBtnDev?.classList.add('active');
      if (tabBtnDev) {
        tabBtnDev.style.borderBottom = '2px solid var(--primary)';
        tabBtnDev.style.color = 'var(--primary)';
        tabBtnDev.style.fontWeight = '700';
      }
      tabBtnClient?.classList.remove('active');
      if (tabBtnClient) {
        tabBtnClient.style.borderBottom = '2px solid transparent';
        tabBtnClient.style.color = 'var(--text-secondary)';
        tabBtnClient.style.fontWeight = '600';
      }
      modalColDev?.classList.remove('hidden');
      modalColClient?.classList.add('hidden');
    } else {
      tabBtnClient?.classList.add('active');
      if (tabBtnClient) {
        tabBtnClient.style.borderBottom = '2px solid var(--primary)';
        tabBtnClient.style.color = 'var(--primary)';
        tabBtnClient.style.fontWeight = '700';
      }
      tabBtnDev?.classList.remove('active');
      if (tabBtnDev) {
        tabBtnDev.style.borderBottom = '2px solid transparent';
        tabBtnDev.style.color = 'var(--text-secondary)';
        tabBtnDev.style.fontWeight = '600';
      }
      modalColClient?.classList.remove('hidden');
      modalColDev?.classList.add('hidden');
    }
  }

  if (tabBtnDev) tabBtnDev.addEventListener('click', () => setModalTabActive('dev'));
  if (tabBtnClient) tabBtnClient.addEventListener('click', () => setModalTabActive('client'));

  const modal = document.getElementById('complaint-modal');
  function toggleModal(show: boolean) {
    if (show) modal?.classList.remove('hidden');
    else modal?.classList.add('hidden');
  }
  document.getElementById('close-modal-btn')?.addEventListener('click', () => toggleModal(false));
  document.getElementById('cancel-modal-btn')?.addEventListener('click', () => toggleModal(false));

  const photoModal = document.getElementById('photo-preview-modal');
  const photoEl = document.getElementById('photo-preview-element') as HTMLImageElement;
  const photoTitle = document.getElementById('photo-preview-modal-title');

  (window as any).showPhotoPreview = (url: string, title?: string) => {
    if (photoEl) photoEl.src = getDirectDriveUrl(url, 'image');
    if (photoTitle) photoTitle.textContent = title || 'Image Preview';
    photoModal?.classList.remove('hidden');
  };

  (window as any).closePhotoPreviewModal = () => {
    photoModal?.classList.add('hidden');
  };

  // Expose global edit/delete helper functions
  (window as any).openEditComplaint = (taskId: string) => {
    const task = allTasks.find(t => t.id === taskId);
    if (!task) return;

    toggleModal(true);

    // Default active tab
    if (task.status === 'review') {
      setModalTabActive('client');
    } else {
      setModalTabActive('dev');
    }

    const idInput = document.getElementById('complaint-id-input') as HTMLInputElement;
    const modalTitle = document.getElementById('modal-title');
    const categorySelect = document.getElementById('category') as HTMLSelectElement;
    const titleInput = document.getElementById('modal-title-input') as HTMLInputElement;
    const descriptionTextarea = document.getElementById('description') as HTMLTextAreaElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const submitBtnText = document.getElementById('btn-text');

    if (idInput) idInput.value = task.id;
    if (modalTitle) modalTitle.textContent = 'Edit Complaint / Request Details';
    if (categorySelect) categorySelect.value = task.category;
    if (titleInput) titleInput.value = task.title || '';
    if (descriptionTextarea) descriptionTextarea.value = task.description;
    if (submitBtnText) submitBtnText.textContent = 'Update Request';

    // Populate Parent Task Tag select in Modal
    const modalParentSelect = document.getElementById('modal-parent-task') as HTMLSelectElement;
    if (modalParentSelect) {
      modalParentSelect.innerHTML = '<option value="">-- No Tag (Independent) --</option>';
      allTasks.forEach(t => {
        if (t.id !== task.id) {
          const option = document.createElement('option');
          option.value = t.id;
          option.textContent = `#${t.title || t.category} (${t.status})`;
          modalParentSelect.appendChild(option);
        }
      });
      modalParentSelect.value = task.parent_task_id || '';
    }

    // Populate Linked Request display info in Modal
    const taggedTaskInfo = document.getElementById('modal-tagged-task-info');
    if (taggedTaskInfo) {
      const parentTask = allTasks.find(t => t.id === task.parent_task_id);
      if (parentTask) {
        taggedTaskInfo.innerHTML = `
          <div style="font-size: 11.5px; font-weight: 600; color: #64748b; margin-bottom: 4px; margin-top: 8px;">Linked Request:</div>
          <div style="display: flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 700; color: #7c3aed; background: #f5f3ff; border: 1px solid #ddd6fe; padding: 8px 12px; border-radius: 6px; cursor: pointer;" onclick="openEditComplaint('${parentTask.id}')">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l5.58-5.58c.94-.94.94-2.48 0-3.42L12 2Z"></path><path d="m7 7-.01.01"></path></svg>
            <span>#${parentTask.title || parentTask.category} (${parentTask.status})</span>
          </div>`;
      } else {
        taggedTaskInfo.innerHTML = '';
      }
    }

    // Populate Tagged Project Update info in Modal
    const modalProjectUpdateId = document.getElementById('modal-project-update-id') as HTMLInputElement;
    if (modalProjectUpdateId) {
      modalProjectUpdateId.value = task.project_update_id || '';
    }
    const taggedUpdateInfo = document.getElementById('modal-tagged-update-info');
    if (taggedUpdateInfo) {
      taggedUpdateInfo.innerHTML = '';
      if (task.project_update_id) {
        const updateIndex = clientUpdates.findIndex(u => u.id === task.project_update_id);
        if (updateIndex !== -1) {
          const seq = clientUpdates.length - updateIndex;
          const up = clientUpdates[updateIndex];
          taggedUpdateInfo.innerHTML = `
            <div style="font-size: 11.5px; font-weight: 600; color: #64748b; margin-bottom: 4px; margin-top: 8px;">Replied Project Update:</div>
            <a href="/client/updates?updateId=${up.id}" style="display: flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 700; color: #2563eb; background: #eff6ff; border: 1px solid #bfdbfe; padding: 8px 12px; border-radius: 6px; cursor: pointer; text-decoration: none;">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
              <span>Update #${seq}</span>
            </a>
          `;
        }
      }
    }

    // Populate Developer Panel
    const devStatusContainer = document.getElementById('modal-dev-status-container');
    const devConclusion = document.getElementById('modal-dev-conclusion');
    const devImage = document.getElementById('modal-dev-image');

    const displayStatus = task.status === 'proses' ? 'In Progress' : (task.status === 'review' ? 'Under Review' : 'Completed');
    
    if (devStatusContainer) {
      devStatusContainer.innerHTML = `<span class="badge ${task.status}">${displayStatus}</span>`;
    }
    if (devConclusion) {
      devConclusion.textContent = task.conclusion ? task.conclusion : 'Awaiting developer response...';
    }
    if (devImage) {
      if (task.image_url) {
        devImage.innerHTML = `
          <div style="cursor: pointer;" onclick="showPhotoPreview('${task.image_url}', 'Deliverables')">
            <img src="${getDirectDriveUrl(task.image_url, 'image')}" style="width: 100%; border-radius: 8px; border: 1px solid #cbd5e1; max-height: 200px; object-fit: contain;" />
          </div>`;
      } else {
        devImage.innerHTML = `<div style="color: #94a3b8; font-style: italic; font-size: 12.5px;">No verification photo uploaded yet.</div>`;
      }
    }

    // Determine lock state (only editable in review status)
    const isLocked = task.status !== 'review';
    
    const lockBanner = document.getElementById('modal-lock-warning-banner');
    if (lockBanner) {
      if (isLocked) lockBanner.classList.remove('hidden');
      else lockBanner.classList.add('hidden');
    }

    [categorySelect, titleInput, descriptionTextarea, modalParentSelect].forEach(el => {
      if (el) {
        if (isLocked) el.setAttribute('disabled', 'true');
        else el.removeAttribute('disabled');
      }
    });

    const dropzoneContent = document.getElementById('dropzone');
    const uploadGroup = document.getElementById('modal-upload-group');
    if (isLocked) {
      if (uploadGroup) uploadGroup.classList.add('hidden');
      if (submitBtn) submitBtn.classList.add('hidden');
    } else {
      if (uploadGroup) uploadGroup.classList.remove('hidden');
      if (submitBtn) submitBtn.classList.remove('hidden');
    }

    // Bind existing media files previews
    const mediaContainer = document.getElementById('modal-media-previews');
    if (mediaContainer) {
      mediaContainer.innerHTML = '';
      if (task.video_url) {
        let mediaUrls = [];
        const urlStr = task.video_url.trim();
        if (urlStr.startsWith('[') && urlStr.endsWith(']')) {
          try {
            mediaUrls = JSON.parse(urlStr);
          } catch(e) {
            mediaUrls = [urlStr];
          }
        } else if (urlStr.length > 0) {
          mediaUrls = [urlStr];
        }

        if (mediaUrls.length > 0) {
          mediaContainer.innerHTML = mediaUrls.map((item: any) => {
            if (typeof item === 'object' && item !== null) {
              return getMediaPreviewHTML(item.url, item.type, item.name);
            } else {
              return getMediaPreviewHTML(item);
            }
          }).join('');
        }
      }
    }

    // Configure Delete Button in Pop-up Footer
    const modalDeleteBtn = document.getElementById('modal-delete-btn');
    if (modalDeleteBtn) {
      if (isLocked) {
        modalDeleteBtn.classList.add('hidden');
      } else {
        modalDeleteBtn.classList.remove('hidden');
        modalDeleteBtn.onclick = () => {
          toggleModal(false);
          deleteComplaint(task.id);
        };
      }
    }

    if (task.video_url) {
      uploadedVideoUrl = task.video_url;
      if (dropzoneContent && !isLocked) {
        dropzoneContent.innerHTML = `
          <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: #15803d; padding: 12px 0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span style="font-size: 13px; font-weight: 700;">✅ Attachment uploaded successfully!</span>
            <p style="font-size: 11px; color: #166534; margin: 0; font-family: monospace;">Existing Attachment (Keep or Replace)</p>
            <input type="file" id="video-file" accept="video/*,image/*,audio/*" class="hidden-file-input" />
          </div>
        `;
        bindDropzoneListeners();
      }
    } else {
      uploadedVideoUrl = "";
      if (dropzoneContent && !isLocked) {
        dropzoneContent.innerHTML = `
          <input type="file" id="video-file" accept="video/*,image/*,audio/*" class="hidden-file-input" />
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dropzone-icon" style="color: var(--text-secondary);"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
          <div class="dropzone-text">
            <span class="highlight">Click to select file</span> or drag and drop
            <p class="formats">Support Video, Photo, or Audio up to 100MB</p>
          </div>
        `;
        bindDropzoneListeners();
      }
    }
  };

  (window as any).deleteComplaint = async (taskId: string) => {
    if (confirm('Are you sure you want to delete this complaint? This action cannot be undone.')) {
      try {
        const response = await fetch(`/api/tasks/${taskId}`, {
          method: 'DELETE'
        });
        const data = await response.json();
        if (response.ok && data.success) {
          alert('Complaint deleted successfully.');
          loadTasks();
        } else {
          alert(`Failed to delete: ${data.error}`);
        }
      } catch (err: any) {
        alert(`Error: ${err.message}`);
      }
    }
  };

  // Filter Event Listeners
  const categoryFilterContainer = document.getElementById('filter-tabs');
  if (categoryFilterContainer) {
    const categoryBtns = categoryFilterContainer.querySelectorAll('.filter-btn');
    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentCategoryFilter = btn.getAttribute('data-category') || 'all';
        renderTasks();
      });
    });
  }

  const statusFilterContainer = document.getElementById('filter-status-tabs');
  if (statusFilterContainer) {
    const statusBtns = statusFilterContainer.querySelectorAll('.filter-btn');
    statusBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        statusBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentStatusFilter = btn.getAttribute('data-status') || 'all';
        renderTasks();
      });
    });
  }

  // Instant pre-upload system
  let uploadedVideoUrl = "";
  const fileIndicator = document.getElementById('file-selected-indicator');

  async function uploadFileInstantly(file: File) {
    if (fileIndicator) fileIndicator.classList.add('hidden');
    
    const dropzoneContent = document.getElementById('dropzone');
    if (!dropzoneContent) return;

    const originalHTML = dropzoneContent.innerHTML;
    
    dropzoneContent.innerHTML = `
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 12px 0;">
        <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line></svg>
        <span style="font-size: 13px; font-weight: 600; color: #2563eb;" id="upload-progress-text">Uploading & compressing to secure storage (0%)...</span>
        <p style="font-size: 11px; color: #64748b; margin: 0;">Do not close this form</p>
      </div>
    `;

    const progressText = document.getElementById('upload-progress-text');

    const formData = new FormData();
    formData.append('video', file);
    formData.append('category', (document.getElementById('category') as HTMLSelectElement).value || 'UI Bug');

    const xhr = new XMLHttpRequest();
    xhr.open('POST', '/api/tasks/upload', true);

    xhr.upload.onprogress = (event) => {
      if (event.lengthComputable) {
        const percentComplete = Math.round((event.loaded / event.total) * 100);
        if (progressText) {
          progressText.textContent = `Uploading & compressing to secure storage (${percentComplete}%)...`;
        }
      }
    };

    xhr.onload = () => {
      if (xhr.status === 200) {
        try {
          const res = JSON.parse(xhr.responseText);
          if (res.success && res.videoUrl) {
            const fileObj = {
              name: file.name,
              url: res.videoUrl,
              type: file.type
            };
            uploadedVideoUrl = JSON.stringify([fileObj]);
            dropzoneContent.innerHTML = `
              <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: #15803d; padding: 12px 0;">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <span style="font-size: 13px; font-weight: 700;">✅ File uploaded & compressed successfully!</span>
                <p style="font-size: 11px; color: #166534; margin: 0; font-family: monospace;">${file.name}</p>
              </div>
            `;
          } else {
            alert(`Upload failed: ${res.error || 'Unknown error'}`);
            dropzoneContent.innerHTML = originalHTML;
            bindDropzoneListeners();
          }
        } catch (e) {
          alert('Failed to parse upload response.');
          dropzoneContent.innerHTML = originalHTML;
          bindDropzoneListeners();
        }
      } else {
        let errorMsg = `Server responded with status ${xhr.status}`;
        try {
          const res = JSON.parse(xhr.responseText);
          if (res.error) errorMsg = res.error;
        } catch(e) {}
        alert(`Upload failed: ${errorMsg}`);
        dropzoneContent.innerHTML = originalHTML;
        bindDropzoneListeners();
      }
    };

    xhr.onerror = () => {
      alert('Network error occurred during video upload.');
      dropzoneContent.innerHTML = originalHTML;
      bindDropzoneListeners();
    };

    xhr.send(formData);
  }

  function bindDropzoneListeners() {
    const videoInput = document.getElementById('video-file') as HTMLInputElement;
    if (videoInput) {
      videoInput.addEventListener('change', () => {
        if (videoInput.files && videoInput.files.length > 0) {
          uploadFileInstantly(videoInput.files[0]);
        }
      });
    }
  }

  // Initial binding
  bindDropzoneListeners();

  // Handle Form Submission
  const complaintForm = document.getElementById('complaint-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const submitLoader = document.getElementById('submit-loader');
  const btnText = document.getElementById('btn-text');

  if (complaintForm && submitBtn && btnText) {
    complaintForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const taskId = (document.getElementById('complaint-id-input') as HTMLInputElement).value;
      const isEdit = taskId.length > 0;

      submitBtn.disabled = true;
      if (submitLoader) submitLoader.classList.remove('hidden');
      btnText.textContent = isEdit ? "Updating request..." : "Saving request...";

      const formData = new FormData();
      formData.append('category', (document.getElementById('category') as HTMLSelectElement).value);
      formData.append('title', (document.getElementById('modal-title-input') as HTMLInputElement).value);
      formData.append('description', (document.getElementById('description') as HTMLTextAreaElement).value);
      
      const modalParentSelect = document.getElementById('modal-parent-task') as HTMLSelectElement;
      if (modalParentSelect && modalParentSelect.value) {
        formData.append('parentTaskId', modalParentSelect.value);
      } else {
        formData.append('parentTaskId', '');
      }

      const modalProjectUpdateId = document.getElementById('modal-project-update-id') as HTMLInputElement;
      if (modalProjectUpdateId && modalProjectUpdateId.value) {
        formData.append('projectUpdateId', modalProjectUpdateId.value);
      } else {
        formData.append('projectUpdateId', '');
      }
      
      if (uploadedVideoUrl) {
        formData.append('videoUrl', uploadedVideoUrl);
      }

      const url = isEdit ? `/api/tasks/${taskId}` : '/api/tasks';
      const method = isEdit ? 'PATCH' : 'POST';

      try {
        const response = await fetch(url, {
          method,
          body: formData
        });

        const data = await response.json();

        submitBtn.disabled = false;
        if (submitLoader) submitLoader.classList.add('hidden');
        btnText.textContent = isEdit ? "Update Request" : "Submit Request";

        if (response.ok && data.success) {
          toggleModal(false);
          complaintForm.reset();
          uploadedVideoUrl = "";
          
          const dropzoneContent = document.getElementById('dropzone');
          if (dropzoneContent) {
            dropzoneContent.innerHTML = `
              <input type="file" id="video-file" accept="video/*,image/*,audio/*" class="hidden-file-input" />
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dropzone-icon"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              <div class="dropzone-text" style="font-size: 12px;">
                <span class="highlight">Click to select new file</span> or drag and drop
              </div>
            `;
            bindDropzoneListeners();
          }
          
          loadTasks();
        } else {
          alert(`Submission failed: ${data.error}`);
        }
      } catch (err: any) {
        submitBtn.disabled = false;
        if (submitLoader) submitLoader.classList.add('hidden');
        btnText.textContent = isEdit ? "Update Request" : "Submit Request";
        alert(`Error connecting to server: ${err.message}`);
      }
    });
  }

  async function loadTasks() {
    const loadingRow = document.getElementById('loading-row');
    const emptyRow = document.getElementById('empty-row');
    const body = document.getElementById('client-tasks-body');
    if (body) {
      body.querySelectorAll('tr:not(#loading-row):not(#empty-row)').forEach(r => r.remove());
    }
    loadingRow?.classList.remove('hidden');
    emptyRow?.classList.add('hidden');
    
    try {
      const response = await fetch(currentProjectId ? `/api/tasks?projectId=${currentProjectId}` : '/api/tasks');
      const data = await response.json();
      if (response.ok && data.success) {
        allTasks = data.tasks || [];
        renderTasks();
      }
    } catch(e) {
      console.error(e);
    }
  }

  function renderTasks() {
    const loadingRow = document.getElementById('loading-row');
    const emptyRow = document.getElementById('empty-row');
    const body = document.getElementById('client-tasks-body');
    
    loadingRow?.classList.add('hidden');
    if (!body) return;
    body.querySelectorAll('tr:not(#loading-row):not(#empty-row)').forEach(r => r.remove());
    
    const filtered = allTasks.filter((t: any) => {
      const catMatch = currentCategoryFilter === 'all' || t.category === currentCategoryFilter;
      const statusMatch = currentStatusFilter === 'all' || t.status === currentStatusFilter;
      return catMatch && statusMatch;
    });
    
    if (filtered.length === 0) {
      emptyRow?.classList.remove('hidden');
      return;
    }
    
    filtered.forEach((task: any, index: number) => {
      const tr = document.createElement('tr');
      tr.style.cursor = 'pointer';
      tr.className = `task-row-${task.status}`;
      tr.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('a') || target.closest('button') || target.closest('img')) {
          return; // avoid opening modal when clicking attachments or hasil kerja links
        }
        openEditComplaint(task.id);
      });
      
      let fileCount = '-';
      if (task.video_url) {
        try {
          const files = JSON.parse(task.video_url);
          if (Array.isArray(files)) {
            fileCount = files.length > 0 ? String(files.length) : '-';
          } else if (task.video_url.trim().length > 0) {
            fileCount = '1';
          }
        } catch(e) {
          if (task.video_url.trim().length > 0) {
            fileCount = '1';
          }
        }
      }
      
      const displayStatus = task.status === 'proses' ? 'In Progress' : (task.status === 'review' ? 'Under Review' : 'Completed');
      const badgeClass = `badge ${task.status}`;
      
      let hasilKerjaHTML = '<span style="color: #94a3b8; font-style: italic;">Awaiting...</span>';
      if (task.image_url) {
        hasilKerjaHTML = `<a href="javascript:void(0)" onclick="event.stopPropagation(); showPhotoPreview('${task.image_url}', 'Deliverables')" style="color: #10b981; font-weight: 600; text-decoration: underline;">View Output</a>`;
      }
      
      let titleHTML = `<div style="font-weight: 700; color: #0f172a;">${task.title || task.category}</div>`;
      if (task.parent_task_id) {
        const parent = allTasks.find(pt => pt.id === task.parent_task_id);
        const parentTitle = parent ? (parent.title || parent.category) : 'Request';
        titleHTML += `
          <div style="margin-top: 4px; display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; color: #7c3aed; background-color: #f5f3ff; border: 1px solid #ddd6fe; padding: 2px 6px; border-radius: 4px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l5.58-5.58c.94-.94.94-2.48 0-3.42L12 2Z"></path></svg>
            <span>Linked: #${parentTitle}</span>
          </div>`;
      }
      
      tr.innerHTML = `
        <td style="font-family: monospace; font-weight: 600; color: #64748b;">${index + 1}</td>
        <td title="${task.title || task.category}">${titleHTML}</td>
        <td title="${task.description || ''}" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #475569;">${task.description || '-'}</td>
        <td style="font-weight: 700; color: #475569; text-align: center;">${fileCount}</td>
        <td><span class="${badgeClass}">${displayStatus}</span></td>
        <td title="${task.conclusion || ''}" style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #475569;">${task.conclusion || '-'}</td>
        <td>${hasilKerjaHTML}</td>
      `;
      body.appendChild(tr);
    });
  }

  // Scroll handler for hiding/showing mobile blue FAB (Add Complaint button)
  let lastScrollTop = 0;
  window.addEventListener('scroll', () => {
    if (window.innerWidth <= 768) {
      const mobileFab = document.querySelector('.workspace-header-bar .btn-primary');
      if (mobileFab) {
        let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        if (scrollTop > lastScrollTop && scrollTop > 60) {
          mobileFab.classList.add('fab-hidden');
        } else {
          mobileFab.classList.remove('fab-hidden');
        }
        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
      }
    }
  }, { passive: true });

  async function initializeProjects() {
    try {
      const response = await fetch('/api/profile');
      const data = await response.json();
      if (response.ok && data.success) {
        clientProjectsList = data.projects || [];
        
        if (projectSelect) {
          projectSelect.innerHTML = '';
          if (clientProjectsList.length === 0) {
            projectSelect.innerHTML = '<option value="">-- No Projects Found --</option>';
            return;
          }
          
          clientProjectsList.forEach((proj) => {
            const option = document.createElement('option');
            option.value = proj.id;
            option.textContent = proj.name;
            projectSelect.appendChild(option);
          });
          
          // Persist selected project using localStorage
          const savedProjectId = localStorage.getItem('activeProjectId');
          const hasSavedProject = savedProjectId && clientProjectsList.some(p => p.id === savedProjectId);
          
          if (hasSavedProject) {
            currentProjectId = savedProjectId;
          } else {
            currentProjectId = clientProjectsList[0].id;
            localStorage.setItem('activeProjectId', currentProjectId);
          }
          projectSelect.value = currentProjectId;
          
          // Add change listener
          projectSelect.addEventListener('change', () => {
            currentProjectId = projectSelect.value;
            localStorage.setItem('activeProjectId', currentProjectId);
            onProjectChange();
          });
        }
      }
    } catch (e) {
      console.error('Error loading client projects:', e);
    }
  }

  // Toggle filters on mobile
  const toggleFiltersBtn = document.getElementById('toggle-filters-btn');
  const filtersContainer = document.getElementById('filters-container');
  if (toggleFiltersBtn && filtersContainer) {
    toggleFiltersBtn.addEventListener('click', () => {
      const isVisible = filtersContainer.classList.toggle('show');
      const btnSpan = toggleFiltersBtn.querySelector('span');
      if (btnSpan) {
        btnSpan.textContent = isVisible ? 'Hide Filters' : 'Show Filters';
      }
    });
  }

  // Initial Load
  initializeProjects().then(() => {
    onProjectChange();
  });
</script>
