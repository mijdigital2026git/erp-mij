---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Header from '../../components/Header.astro';

const user = (Astro.locals as any).user;
if (!user) {
  return Astro.redirect('/login');
}
---

<Layout>
  <head>
    <title>Settings & Security - MIJ ERP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <Sidebar role="client" />

  <div class="app-container">
    <Header userName={user.name} userRole={user.role} title="Settings & Security" />

    <!-- Main Content -->
    <main class="main-content">
      
      <div class="settings-content-layout">
        <!-- App Installation & Native App Downloads Card -->
        <div id="app-downloads-card" class="security-card" style="grid-column: 1 / -1; border-color: #cbd5e1; background: #ffffff;">
          <div class="security-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px; margin-bottom: 14px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: #0f172a;">Application Downloads & Native App</h3>
            </div>
            <span class="badge status-secured" style="background-color: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe;">Online Sync</span>
          </div>
          <p style="margin: 0 0 16px 0; font-size: 13.5px; color: var(--text-secondary); line-height: 1.5;">
            Access this ERP Client Portal as a dedicated application on <strong>Android HP</strong> and <strong>Windows Desktop</strong> — without browser URL headers or loading delay.
          </p>

          <!-- Electron Active Status Banner (Shown when opened inside Electron App) -->
          <div id="electron-active-card" style="display: none; background: #f0fdf4; border: 1.5px solid #22c55e; padding: 16px; border-radius: 6px; margin-bottom: 16px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <div style="background: #22c55e; color: white; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div>
                <strong style="font-size: 14px; color: #15803d; display: block; margin-bottom: 2px;">Terdeteksi: Anda sedang menggunakan Aplikasi Desktop Electron Resmi</strong>
                <span style="font-size: 12.5px; color: #166534; line-height: 1.4;">Portal ERP MIJ berjalan secara native pada perangkat Windows Anda dengan enkripsi SSL & perlindungan sesi aktif. Opsi unduhan disembunyikan karena aplikasi sudah terinstall.</span>
              </div>
            </div>
          </div>

          <!-- Main App Categories Grid -->
          <div id="download-grid-container" style="display: flex; flex-direction: column; gap: 20px;">

            <!-- WINDOWS DESKTOP APPS (ELECTRON & NATIVE) -->
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; border-bottom: 2px solid #e2e8f0; padding-bottom: 6px;">
                <h4 style="margin: 0; font-size: 14px; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 8px;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5"><rect width="20" height="14" x="2" y="3" rx="2"></rect><line x1="8" x2="16" y1="21" y2="21"></line><line x1="12" x2="12" y1="17" y2="21"></line></svg>
                  Windows Native C Desktop App Installer (.EXE)
                </h4>
                <span style="font-size: 11px; font-weight: 700; color: #2563eb; background: #eff6ff; padding: 2px 8px; border-radius: 4px; border: 1px solid #bfdbfe;">Win32 C Native</span>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px;">
                <!-- Native C Desktop App (Featured) -->
                <div style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border: 1.5px solid #3b82f6; padding: 16px; border-radius: 12px; display: flex; flex-direction: column; justify-content: space-between; gap: 14px; position: relative; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.08);">
                  <span style="position: absolute; top: -10px; right: 12px; background: linear-gradient(90deg, #2563eb, #1d4ed8); color: white; font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 20px; letter-spacing: 0.5px; box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);">WIN32 NATIVE C</span>
                  <div>
                    <strong style="font-size: 15px; color: #1e40af; display: block; margin-bottom: 4px; font-weight: 700;">MIJ ERP C Native App (.EXE)</strong>
                    <span style="font-size: 12px; color: #3b82f6; line-height: 1.4; display: block;">Aplikasi Desktop Windows Mandiri Berbasis C Native (Win32 API) — Bebas Browser & Performa Ringan (560 KB)</span>
                  </div>
                  <a href="/downloads/client-app-setup.exe" download="MIJ-ERP-Client-App-C.exe" target="_blank" class="btn-download-modern" style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 18px; font-weight: 700; font-size: 14px; border-radius: 8px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; text-decoration: none; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3); border: none; transition: transform 0.15s ease;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    <span>Download Native C App (.EXE)</span>
                  </a>
                </div>

                <!-- Windows Zip Portable Package -->
                <div style="background-color: #ffffff; border: 1px solid #e2e8f0; padding: 16px; border-radius: 12px; display: flex; flex-direction: column; justify-content: space-between; gap: 14px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);">
                  <div>
                    <strong style="font-size: 15px; color: #0f172a; display: block; margin-bottom: 4px; font-weight: 700;">Windows Portable App Package (.ZIP)</strong>
                    <span style="font-size: 12px; color: #64748b; line-height: 1.4; display: block;">Versi Portable Standalone — Langsung Ekstrak & Jalankan Tanpa Proses Install</span>
                  </div>
                  <a href="/downloads/client-app-standalone.zip" download target="_blank" class="btn-download-modern" style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 18px; font-weight: 700; font-size: 14px; border-radius: 8px; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff; text-decoration: none; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.25); border: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    <span>Download Package Portable (.ZIP)</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- ANDROID MOBILE APPS (.APK PER VERSION) -->
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; border-bottom: 2px solid #e2e8f0; padding-bottom: 6px;">
                <h4 style="margin: 0; font-size: 14px; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 8px;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect><line x1="12" x2="12.01" y1="18" y2="18"></line></svg>
                  Android Native APK Installers per OS Version
                </h4>
                <span style="font-size: 11px; font-weight: 700; color: #16a34a; background: #dcfce7; padding: 2px 8px; border-radius: 4px; border: 1px solid #bbf7d0;">Signed Release Keys</span>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
                <!-- Android 14 -->
                <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; padding: 12px; display: flex; flex-direction: column; justify-content: space-between; gap: 8px;">
                  <div>
                    <strong style="font-size: 13px; color: #0f172a; display: block;">Android 14 (API 34)</strong>
                    <span style="font-size: 11px; color: #64748b;">Versi HP Terbaru</span>
                  </div>
                  <a href="/downloads/client-app-v14.apk" download target="_blank" class="btn btn-secondary" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 10px; font-weight: 700; font-size: 12px; background-color: #16a34a; border-color: #15803d; color: #ffffff; text-decoration: none;">
                    <span>Download APK v14</span>
                  </a>
                </div>

                <!-- Android 13 -->
                <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; padding: 12px; display: flex; flex-direction: column; justify-content: space-between; gap: 8px;">
                  <div>
                    <strong style="font-size: 13px; color: #0f172a; display: block;">Android 13 (API 33)</strong>
                    <span style="font-size: 11px; color: #64748b;">Optimized Security</span>
                  </div>
                  <a href="/downloads/client-app-v13.apk" download target="_blank" class="btn btn-secondary" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 10px; font-weight: 700; font-size: 12px; background-color: #16a34a; border-color: #15803d; color: #ffffff; text-decoration: none;">
                    <span>Download APK v13</span>
                  </a>
                </div>

                <!-- Android 12 -->
                <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; padding: 12px; display: flex; flex-direction: column; justify-content: space-between; gap: 8px;">
                  <div>
                    <strong style="font-size: 13px; color: #0f172a; display: block;">Android 12 (API 31)</strong>
                    <span style="font-size: 11px; color: #64748b;">Material You Support</span>
                  </div>
                  <a href="/downloads/client-app-v12.apk" download target="_blank" class="btn btn-secondary" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 10px; font-weight: 700; font-size: 12px; background-color: #16a34a; border-color: #15803d; color: #ffffff; text-decoration: none;">
                    <span>Download APK v12</span>
                  </a>
                </div>

                <!-- Android Universal / Legacy -->
                <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; padding: 12px; display: flex; flex-direction: column; justify-content: space-between; gap: 8px;">
                  <div>
                    <strong style="font-size: 13px; color: #0f172a; display: block;">Android Universal APK</strong>
                    <span style="font-size: 11px; color: #64748b;">Kompatibel Semua HP</span>
                  </div>
                  <a href="/downloads/client-app.apk" download target="_blank" class="btn btn-secondary" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 10px; font-weight: 700; font-size: 12px; background-color: #15803d; border-color: #166534; color: #ffffff; text-decoration: none;">
                    <span>Download APK Universal</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- PWA INSTANT WEB APP -->
            <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
              <div>
                <strong style="font-size: 13.5px; color: #0f172a; display: block;">Instant PWA Web App (Chrome / Edge)</strong>
                <span style="font-size: 12px; color: #64748b;">Install langsung via browser tanpa download installer (Bebas Peringatan Virus)</span>
              </div>
              <button type="button" id="pwa-install-btn" class="btn btn-primary" style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 16px; font-weight: 700; border-radius: 0px; background-color: #2563eb; border-color: #2563eb; color: #ffffff; cursor: pointer;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v10"></path><path d="m17 8-5 5-5-5"></path><rect x="3" y="16" width="18" height="6" rx="1"></rect></svg>
                <span id="pwa-install-text">Install App to Device</span>
              </button>
            </div>

          </div>

          <!-- Security Installation Guidance Note -->
          <div style="margin-top: 14px; background: #fffbe6; border: 1px solid #ffe58f; padding: 12px 14px; border-radius: 4px; display: flex; align-items: flex-start; gap: 10px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d48806" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            <div style="font-size: 12.5px; color: #734a00; line-height: 1.5;">
              <strong>Panduan Keamanan Instalasi (.EXE & .APK):</strong>
              <ul style="margin: 4px 0 0 0; padding-left: 18px;">
                <li><strong>Windows Defender SmartScreen:</strong> Jika muncul peringatan <em>"Windows protected your PC"</em> saat membuka `.exe`, klik <strong>"More info"</strong> lalu pilih <strong>"Run anyway"</strong> (File ini 100% aman dan telah diverifikasi).</li>
                <li><strong>Android Play Protect:</strong> Jika muncul prompt izin saat install `.apk`, pilih <strong>"Allow / Install anyway"</strong>.</li>
                <li><strong>Tanpa Peringatan Virus:</strong> Gunakan tombol <strong>"Install App to Device" (PWA)</strong> untuk memasang aplikasi instan via browser resmi.</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="security-card">
          <div class="security-header">
            <h3>Device Session Limits</h3>
            <span class="badge status-secured">Active Protection</span>
          </div>
          <p style="margin: 0; font-size: 13.5px; color: var(--text-secondary); line-height: 1.5;">To secure your client portal, active logins are limited to a configurable maximum of devices simultaneously. Attempting to log in on an additional device will auto-kick the oldest active session.</p>
          
          <div class="device-limit-gauge">
            <span id="session-count-label" class="gauge-label">1 / 2 Devices Active</span>
            <div class="gauge-bar">
              <div id="session-gauge-fill" class="gauge-fill" style="width: 50%;"></div>
            </div>
          </div>

          <div style="margin-top: 15px; border-top: 1px solid #e2e8f0; padding-top: 15px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <label for="device-limit-select" style="font-size: 13.5px; font-weight: 700; color: var(--text-primary);">Configure Max Devices:</label>
              <select id="device-limit-select" style="border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 12px; font-size: 13px; font-weight: 600; font-family: inherit; background-color: white; cursor: pointer; outline: none; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                <option value="1">1 Device</option>
                <option value="2">2 Devices (Default)</option>
                <option value="3">3 Devices</option>
                <option value="4">4 Devices</option>
                <option value="5">5 Devices</option>
                <option value="10">10 Devices</option>
              </select>
            </div>
            <button type="button" class="btn btn-secondary" id="update-limit-btn" style="padding: 6px 12px; font-size: 13px; background-color: #eff6ff; color: #2563eb; border-color: #bfdbfe; font-weight: 700;">Save Limit</button>
          </div>
        </div>

        <div class="sessions-list-card">
          <div class="card-header-row">
            <h3>Currently Logged In Devices</h3>
            <button class="btn btn-secondary" id="logout-other-devices-btn" style="background-color: #fee2e2; border-color: #fca5a5; color: #b91c1c;">
              Log Out Other Devices
            </button>
          </div>

          <div class="sessions-table-wrapper">
            <table class="excel-table">
              <thead>
                <tr>
                  <th>Device Details</th>
                  <th>Last Active Time</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="sessions-list-body">
                <tr>
                  <td colspan="3" style="text-align: center; padding: 16px;">Loading sessions...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer style="margin-top: auto; padding: 16px 24px; border-top: 1px solid #cbd5e1; text-align: center; font-size: 12px; color: #64748b; background-color: #ffffff; width: 100%; box-sizing: border-box;">
      &copy; {new Date().getFullYear()} MIJ Digital. All rights reserved.
    </footer>
  <!-- Confirm Limit Change Modal -->
  <div class="modal-overlay hidden" id="confirm-limit-modal" style="z-index: 130;">
    <div class="modal-card" style="max-width: 450px; width: 95%; border-radius: 0px; overflow: hidden; background-color: #ffffff; border: 1px solid var(--border-color); display: flex; flex-direction: column;">
      <div class="modal-header" style="background-color: #f8fafc; border-bottom: 1px solid #cbd5e1; display: flex; justify-content: space-between; align-items: center; padding: 14px 20px;">
        <h2 style="margin: 0; font-size: 16px; font-weight: 700; color: var(--text-primary);">Confirm Session Limit Change</h2>
        <button class="close-btn" style="background: none; border: none; font-size: 24px; cursor: pointer; color: var(--text-secondary);" onclick="closeConfirmLimitModal()">&times;</button>
      </div>
      <div class="modal-body" style="padding: 20px; display: flex; flex-direction: column; gap: 12px;">
        <p style="margin: 0; font-size: 13.5px; color: var(--text-secondary); line-height: 1.5;">To confirm changes to your device session limit, please enter your portal <strong>Login Code</strong>:</p>
        <input type="password" id="confirm-login-code" placeholder="Enter Login Code (e.g. CLIENT123)" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 6px; padding: 8px 12px; font-size: 14px; box-sizing: border-box; outline: none; font-family: monospace;" />
        <div id="confirm-limit-error" style="color: #dc2626; font-size: 12.5px; font-weight: 600;" class="hidden"></div>
      </div>
      <div class="modal-footer" style="padding: 12px 20px; background-color: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; justify-content: flex-end; gap: 8px;">
        <button type="button" class="btn btn-secondary" onclick="closeConfirmLimitModal()">Cancel</button>
        <button type="button" class="btn btn-primary" id="submit-limit-change-btn" style="background-color: #2563eb; color: white;">Confirm & Save</button>
      </div>
    </div>
  </div>
  </div>
</Layout>

<style>
  :root {
    --bg-light: #f8fafc;
    --bg-card: #ffffff;
    --border-color: #cbd5e1;
    --text-primary: #0f172a;
    --text-secondary: #475569;
    --primary: #2563eb;
    --primary-hover: #1d4ed8;
    --primary-light: rgba(37, 99, 235, 0.05);

    --font-heading: system-ui, -apple-system, sans-serif;
    --font-body: system-ui, -apple-system, sans-serif;
  }

  body {
    background-color: var(--bg-light);
    color: var(--text-primary);
    font-family: var(--font-body);
    margin: 0;
  }

  .app-container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding-left: 240px;
    transition: padding-left 0.2s ease-in-out;
  }

  /* When collapsed */
  body.sidebar-collapsed .app-container {
    padding-left: 0;
  }

  body.sidebar-collapsed :global(.app-sidebar) {
    transform: translateX(-240px);
  }

  .main-content {
    flex-grow: 1;
    padding: 24px;
    background-color: #ffffff;
    min-height: calc(100vh - 64px);
    box-sizing: border-box;
    min-width: 0;
    overflow: hidden;
  }

  .settings-content-layout {
    display: flex;
    flex-direction: column;
    gap: 24px;
    text-align: left;
  }

  .security-card {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .security-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .security-header h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .badge {
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
  }

  .badge.status-secured {
    background-color: #dcfce7;
    color: #15803d;
    border: 1px solid #86efac;
  }

  .device-limit-gauge {
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .gauge-bar {
    height: 8px;
    background-color: #f1f5f9;
    border-radius: 4px;
    overflow: hidden;
    width: 100%;
    max-width: 300px;
    border: 1px solid #cbd5e1;
  }

  .gauge-fill {
    height: 100%;
    background-color: var(--primary);
    border-radius: 4px;
    transition: width 0.3s ease;
  }

  .gauge-label {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .sessions-list-card {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .card-header-row h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .sessions-table-wrapper {
    width: 100%;
    overflow-x: auto;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
  }

  .excel-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    white-space: nowrap;
  }

  .excel-table th {
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: var(--text-primary);
    font-weight: 700;
    padding: 8px 12px;
    text-align: left;
  }

  .excel-table td {
    border: 1px solid #cbd5e1;
    padding: 8px 12px;
  }

  .excel-table tr:hover {
    background-color: #f8fafc;
  }

  /* Buttons */
  .btn {
    border: 1px solid transparent;
    outline: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13.5px;
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    transition: background-color 0.15s ease;
  }

  .btn-secondary {
    background-color: #ffffff;
    color: var(--text-primary);
    border: 1px solid #cbd5e1;
  }

  .btn-secondary:hover {
    background-color: #f1f5f9;
  }

  @media (max-width: 768px) {
    .main-content {
      padding: 16px 12px !important;
    }
    .card-header-row {
      flex-direction: column;
      align-items: flex-start !important;
    }
    #logout-other-devices-btn {
      width: 100% !important;
      justify-content: center;
    }
  }
</style>

<script>
  // Active Sessions & device security list
  async function loadSessions() {
    const tbody = document.getElementById('sessions-list-body');
    const label = document.getElementById('session-count-label');
    const fill = document.getElementById('session-gauge-fill');
    if (!tbody) return;

    try {
      const response = await fetch('/api/sessions');
      const data = await response.json();

      if (response.ok && data.success) {
        const sessions = data.sessions;
        const count = sessions.length;
        
        let deviceLimit = 2;
        try {
          const limitRes = await fetch('/api/device-limit');
          const limitData = await limitRes.json();
          if (limitRes.ok && limitData.success) {
            deviceLimit = limitData.limit;
          }
        } catch (e) {}

        if (label) label.textContent = `${count} / ${deviceLimit} Devices Active`;
        if (fill) {
          fill.style.width = `${(count / deviceLimit) * 100}%`;
          if (count >= deviceLimit) fill.style.backgroundColor = '#dc2626';
          else fill.style.backgroundColor = '#2563eb';
        }

        const cookies = document.cookie.split(';').reduce((res, c) => {
          const [key, val] = c.trim().split('=');
          res[key] = val;
          return res;
        }, {} as any);
        const currentToken = cookies['session_user_client'] || cookies['session_user_admin'] || cookies['session_user'] || "";

        tbody.innerHTML = sessions.map((sess: any) => {
          const lastActive = new Date(sess.updated_at).toLocaleString('en-US', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          });

          const isCurrent = currentToken === sess.token;

          // Parse device name from session ID
          const parts = sess.id.split('@@');
          const deviceName = parts.length > 1 ? parts[1] : (sess.id.startsWith('token-') ? 'Desktop Web' : 'Authorized Device');
          
          let deviceIcon = '🖥️';
          if (deviceName.includes('iPhone') || deviceName.includes('Android Phone')) {
            deviceIcon = '📱';
          } else if (deviceName.includes('iPad') || deviceName.includes('Tablet')) {
            deviceIcon = '📟';
          }

          return `
            <tr>
              <td style="font-family: inherit; font-size: 13.5px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 16px;">${deviceIcon}</span>
                <span>${deviceName}</span>
                ${isCurrent ? '<span style="font-size: 10px; font-weight: 700; color: #10b981; background-color: #ecfdf5; border: 1px solid #a7f3d0; padding: 2px 6px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.05em;">This Device</span>' : ''}
                <span style="font-family: monospace; font-size: 11px; color: #94a3b8; font-weight: 400; margin-left: auto;">(${sess.token.substring(0, 10)}...)</span>
              </td>
              <td>${lastActive}</td>
              <td>
                <span class="badge" style="background-color: ${isCurrent ? '#dcfce7' : '#fef3c7'}; color: ${isCurrent ? '#15803d' : '#b45309'}; border: 1px solid ${isCurrent ? '#86efac' : '#fca5a5'};">
                  ${isCurrent ? 'Active Now' : 'Idle'}
                </span>
              </td>
            </tr>
          `;
        }).join('');
      } else {
        tbody.innerHTML = `<tr><td colspan="3" style="text-align: center; color: red;">Failed to load sessions: ${data.error}</td></tr>`;
      }
    } catch (err: any) {
      tbody.innerHTML = `<tr><td colspan="3" style="text-align: center; color: red;">Error: ${err.message}</td></tr>`;
    }
  }

  // Load current configured device limit into select field
  async function loadDeviceLimit() {
    const select = document.getElementById('device-limit-select') as HTMLSelectElement;
    if (!select) return;
    try {
      const response = await fetch('/api/device-limit');
      const data = await response.json();
      if (response.ok && data.success) {
        select.value = String(data.limit);
      }
    } catch (e) {
      console.error('Failed to load device limit:', e);
    }
  }

  // Confirm Limit Change Modal Handlers
  const confirmLimitModal = document.getElementById('confirm-limit-modal');
  const confirmCodeInput = document.getElementById('confirm-login-code') as HTMLInputElement;
  const confirmError = document.getElementById('confirm-limit-error');
  const updateLimitBtn = document.getElementById('update-limit-btn');
  const submitChangeBtn = document.getElementById('submit-limit-change-btn');
  const limitSelect = document.getElementById('device-limit-select') as HTMLSelectElement;

  function closeConfirmLimitModal() {
    confirmLimitModal?.classList.add('hidden');
    if (confirmCodeInput) confirmCodeInput.value = '';
    if (confirmError) confirmError.classList.add('hidden');
  }

  (window as any).closeConfirmLimitModal = closeConfirmLimitModal;

  if (updateLimitBtn) {
    updateLimitBtn.addEventListener('click', () => {
      confirmLimitModal?.classList.remove('hidden');
      confirmCodeInput?.focus();
    });
  }

  if (submitChangeBtn) {
    submitChangeBtn.addEventListener('click', async () => {
      if (!confirmCodeInput || !limitSelect) return;
      const code = confirmCodeInput.value.trim();
      const limit = limitSelect.value;

      if (!code) {
        if (confirmError) {
          confirmError.textContent = 'Please enter your login code.';
          confirmError.classList.remove('hidden');
        }
        return;
      }

      if (confirmError) confirmError.classList.add('hidden');

      try {
        const response = await fetch('/api/device-limit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ limit, code })
        });
        const data = await response.json();
        
        if (response.ok && data.success) {
          alert(`Successfully updated device limit to ${limit}.`);
          closeConfirmLimitModal();
          loadSessions();
        } else {
          if (confirmError) {
            confirmError.textContent = data.error || 'Failed to update limit.';
            confirmError.classList.remove('hidden');
          }
        }
      } catch (err: any) {
        if (confirmError) {
          confirmError.textContent = `Error: ${err.message}`;
          confirmError.classList.remove('hidden');
        }
      }
    });
  }

  // PWA Install Prompt Handler
  let deferredPrompt: any = null;
  const pwaInstallBtn = document.getElementById('pwa-install-btn');
  const pwaInstallText = document.getElementById('pwa-install-text');

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    if (pwaInstallBtn && pwaInstallText) {
      pwaInstallBtn.style.display = 'flex';
      pwaInstallText.textContent = 'Install App to Device (Instant Native App)';
    }
  });

  if (pwaInstallBtn) {
    pwaInstallBtn.addEventListener('click', async () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          console.log('User accepted PWA installation');
        }
        deferredPrompt = null;
      } else {
        alert('To install on HP/Laptop:\n\n• On Android: Tap Chrome Menu (3 dots) ➔ "Add to Home screen" or "Install app".\n• On Windows: Click the Install Icon in your browser address bar.');
      }
    });
  }

  // Logout other devices click handler
  const logoutOtherBtn = document.getElementById('logout-other-devices-btn');
  if (logoutOtherBtn) {
    logoutOtherBtn.addEventListener('click', async () => {
      if (confirm('Are you sure you want to log out from all other devices? This will terminate their active sessions.')) {
        try {
          const response = await fetch('/api/sessions', {
            method: 'DELETE'
          });
          const data = await response.json();
          if (response.ok && data.success) {
            alert('Logged out from other devices successfully.');
            loadSessions();
          } else {
            alert(`Failed: ${data.error}`);
          }
        } catch (err: any) {
          alert(`Error: ${err.message}`);
        }
      }
    });
  }

  // Auto-Detect Electron Desktop App Environment
  const ua = navigator.userAgent.toLowerCase();
  const isElectronApp = ua.includes('electron') || ua.includes('mij-erp-desktop') || (window.process && (window.process as any).versions?.electron);
  
  const downloadGrid = document.getElementById('download-grid-container');
  const electronCard = document.getElementById('electron-active-card');

  if (isElectronApp) {
    if (downloadGrid) downloadGrid.style.display = 'none';
    if (electronCard) electronCard.style.display = 'block';
  }

  // Initial Load
  loadDeviceLimit().then(() => {
    loadSessions();
  });
</script>
