{
  "name": "mij-erp-client-desktop",
  "version": "1.0.0",
  "description": "MIJ ERP Digital Client Portal Standalone Desktop Application",
  "main": "main.js",
  "author": "PT MIJ Digital Indonesia",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.mijdigital.erpclient",
    "productName": "MIJ ERP Client Portal",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MIJ ERP Client Portal"
    }
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  }
}
