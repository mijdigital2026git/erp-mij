{
  "name": "gullible-graham",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npx esbuild dist/server/entry.mjs --bundle --outfile=dist/_worker.js --platform=neutral --format=esm --external:cloudflare:workers && cp -r dist/client/* dist/",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply erp_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply erp_db --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@lucide/astro": "^1.28.0",
    "astro": "^7.1.6",
    "lucide-astro": "^0.556.0",
    "wrangler": "^4.116.0"
  }
}
